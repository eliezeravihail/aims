+    'en/guide.md': '# User guide\n\n## Install\n\nInstall the thing.',
+    'en/sub/page.md': '# Sub page\n\nSee [install](../guide.md#install).',
+    'en/img/logo.png': 'fake image',
+    'fr/index.md': '# Bienvenue\n\nBonjour lecteur. Lisez [le guide](guide.md).',
+    'fr/only-fr.md': '# Seulement en français\n\nContenu français.',
+    'he/index.md': '# ברוכים הבאים\n\nשלום.',
+}
+
+
+def read(*parts: str) -> str:
+    return Path(*parts).read_text(encoding='utf-8')
+
+
+def titles_in_search_index(site_dir: str) -> dict[str, str]:
+    with open(os.path.join(site_dir, 'search', 'search_index.json'), encoding='utf-8') as f:
+        index = json.load(f)
+    return {doc['location']: doc['title'] for doc in index['docs'] if '#' not in doc['location']}
+
+
+class LanguagesConfigTests(ConfigTestCase):
+    class Schema(Config):
+        docs_dir = c.Dir(exists=True)
+        languages = c.Languages()
+
+    @tempdir(['en/index.md'])
+    def test_not_set(self, docs_dir):
+        conf = self.get_config(self.Schema, {'docs_dir': docs_dir})
+        self.assertIsNone(conf.languages)
+
+    @tempdir(['en/index.md'])
+    def test_valid(self, docs_dir):
+        conf = self.get_config(
+            self.Schema,
+            {'docs_dir': docs_dir, 'languages': {'default': 'en', 'others': ['fr', 'pt_BR']}},
+        )
+        self.assertEqual(conf.languages.default, 'en')
+        self.assertEqual(conf.languages.others, ['fr', 'pt_BR'])
+        self.assertEqual(conf.languages.codes, ['en', 'fr', 'pt_BR'])
+
+    @tempdir(['en/index.md'])
+    def test_default_only(self, docs_dir):
+        conf = self.get_config(self.Schema, {'docs_dir': docs_dir, 'languages': {'default': 'en'}})
+        self.assertEqual(conf.languages.codes, ['en'])
+
+    @tempdir(['en/index.md'])
+    def test_missing_default(self, docs_dir):
+        with self.expect_error(
+            languages="Sub-option 'default': Required configuration not provided."
+        ):
+            self.get_config(self.Schema, {'docs_dir': docs_dir, 'languages': {'others': ['fr']}})
+
+    @tempdir(['en/index.md'])
+    def test_not_a_mapping(self, docs_dir):
+        with self.expect_error(
+            languages="Expected a mapping with a 'default' language and optionally a list of "
+            "'others', but received: <class 'list'>"
+        ):
+            self.get_config(self.Schema, {'docs_dir': docs_dir, 'languages': ['en', 'fr']})
