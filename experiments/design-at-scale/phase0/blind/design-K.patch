+"""
+Multi-language sites.
+
+A site whose config declares `languages` is built as one site per language. The pages of
+language `xx` are read from `docs_dir/xx/` and written to `site_dir/xx/`; the default language
+is built a second time at the root of `site_dir`.
+
+Every language site contains every page. Where a language has no translation of a page, its
+site takes the page from the default language (failing that, from the other languages in their
+declared order) and shows it in its own chrome, marked as untranslated. As a result all
+language sites have the same set of pages at the same paths, which is what makes the links
+between the translations of a page (`Alternate`) always valid.
+
+This module holds the model (`Language`, `Alternate`) and `LanguageSite`, which assembles the
+files of one language site and localizes its navigation and pages. The build of each site is
+driven by `mkdocs.commands.build`.
+"""
+
+from __future__ import annotations
+
+import contextlib
+import logging
+import os
+from dataclasses import dataclass
+from typing import TYPE_CHECKING, Callable, Iterator, Sequence
+from urllib.parse import urljoin
+
+import jinja2
+from markupsafe import escape
+
+from mkdocs import localization
+from mkdocs.exceptions import BuildError
+from mkdocs.structure.files import Files, InclusionLevel, file_sort_key, get_files
+from mkdocs.structure.pages import _AbsoluteLinksValidationValue
+
+if TYPE_CHECKING:
+    from mkdocs.config.defaults import MkDocsConfig
+    from mkdocs.structure.files import File
+    from mkdocs.structure.pages import Page
+    from mkdocs.utils.templates import TemplateContext
+
+
+log = logging.getLogger(__name__)
+
+
+# Used only when Babel is not installed; with Babel, names and directions come from CLDR.
+_RTL_LANGUAGES = frozenset(
+    {'ar', 'arc', 'ckb', 'dv', 'fa', 'he', 'iw', 'ks', 'ku', 'ps', 'sd', 'ug', 'ur', 'yi'}
+)
+_ENDONYMS = {
+    'ar': 'العربية', 'bg': 'Български', 'bn': 'বাংলা', 'ca': 'Català', 'cs': 'Čeština',
+    'da': 'Dansk', 'de': 'Deutsch', 'el': 'Ελληνικά', 'en': 'English', 'es': 'Español',
+    'et': 'Eesti', 'fa': 'فارسی', 'fi': 'Suomi', 'fr': 'Français', 'he': 'עברית',
+    'hi': 'हिन्दी', 'hr': 'Hrvatski', 'hu': 'Magyar', 'id': 'Indonesia', 'it': 'Italiano',
+    'ja': '日本語', 'ko': '한국어', 'lt': 'Lietuvių', 'lv': 'Latviešu', 'nb': 'Norsk bokmål',
+    'nl': 'Nederlands', 'nn': 'Norsk nynorsk', 'no': 'Norsk', 'pl': 'Polski',
+    'pt': 'Português', 'ro': 'Română', 'ru': 'Русский', 'sk': 'Slovenčina',
+    'sl': 'Slovenščina', 'sr': 'Српски', 'sv': 'Svenska', 'th': 'ไทย', 'tr': 'Türkçe',
+    'uk': 'Українська', 'ur': 'اردو', 'vi': 'Tiếng Việt', 'zh': '中文',
+}  # fmt: skip
+
+
+@dataclass(frozen=True)
+class Language:
+    """A language of a multi-language site."""
+
+    code: str
+    """The code as declared in the config (`fr`, `pt_BR`); also the name of the language's
+    directory in `docs_dir` and of its URL prefix."""
+
+    name: str
+    """The name of the language in that language ("Français"), for language selectors."""
+
+    direction: str
+    """The writing direction of the language: `ltr` or `rtl`."""
+
+    is_default: bool = False
+    """Whether this is the default language of the site."""
+
+    @property
+    def html_lang(self) -> str:
+        """The code as a BCP 47 tag (`pt-BR`), for `lang` and `hreflang` attributes."""
+        return self.code.replace('_', '-')
+
+    @classmethod
+    def from_code(cls, code: str, *, is_default: bool = False) -> Language:
+        locale = localization.parse_locale(code)
+        if localization.has_babel:
+            name = locale.get_display_name() or code
+            name = name[:1].upper() + name[1:]
+            rtl = locale.character_order == 'right-to-left'
+        else:
+            name = _ENDONYMS.get(locale.language, code)
+            if locale.territory:
+                name = f'{name} ({locale.territory})'
+            rtl = locale.language in _RTL_LANGUAGES
+        return cls(code, name, 'rtl' if rtl else 'ltr', is_default=is_default)
+
+
+@dataclass(frozen=True)
+class Alternate:
+    """The version of the current page (or template) in one of the languages of the site."""
+
+    language: Language
+    """The language of this version."""
+
+    url: str
+    """The URL of this version, relative to the root of the *current* language site, like the
+    URLs of navigation items. Pass it through the `url` template filter."""
+
+    canonical_url: str | None
+    """The full URL of this version in its language's site, if `site_url` is set."""
+
+    active: bool
+    """Whether this is the version being viewed."""
+
+    translated: bool
+    """Whether the language has its own translation of the page. When `False`, this version
+    shows the untranslated page in that language's chrome."""
+
+
+def get_languages(config: MkDocsConfig) -> list[Language]:
+    """Return the languages of the site, the default one first; empty for a single-language site."""
+    if config.languages is None:
+        return []
+    return [
+        Language.from_code(code, is_default=(code == config.languages.default))
+        for code in config.languages.codes
+    ]
+
+
+def get_language_sites(config: MkDocsConfig) -> list[LanguageSite]:
+    """
+    Return the sites to build for a multi-language config, in build order.
+
+    The default language at the site root comes first, then every language (the default one
+    included) under its own prefix.
+    """
+    languages = get_languages(config)
+    if not languages:
+        return []
+    default = languages[0]
+    return [
+        LanguageSite(default, languages, config, prefix=''),
+        *(LanguageSite(lang, languages, config, prefix=f'{lang.code}/') for lang in languages),
+    ]
+
+
+def warn_about_files_outside_languages(config: MkDocsConfig) -> None:
+    """Report entries of `docs_dir` that are not in the directory of any declared language."""
+    assert config.languages is not None
+    codes = set(config.languages.codes)
+    stray = sorted(
+        name
+        for name in os.listdir(config.docs_dir)
+        if name not in codes and not name.startswith('.') and name != 'templates'
+    )
+    if stray:
+        log.warning(
+            "The following items in the docs directory are outside the directories of the "
+            "declared languages, and are not part of the site:\n  - " + '\n  - '.join(stray)
+        )
+
+
+class LanguageSite:
+    """
+    One site of a multi-language build: a language, served under a URL prefix.
+
+    `prefix` is `'fr/'` for the site of `fr`, and `''` for the default language's copy at the
+    root of the site.
+
+    Use it in this order during a build: `configure()` the config for the site, then
+    `collect_files()`, then `localize_nav()` and `localize_page()`.
+    """
+
+    def __init__(
+        self,
+        language: Language,
+        languages: Sequence[Language],
+        config: MkDocsConfig,
+        *,
+        prefix: str,
+    ) -> None:
+        self.language = language
+        self.languages = list(languages)
+        self.prefix = prefix
+        self._root_docs_dir = config.docs_dir
+        self._root_site_dir = config.site_dir
+        self._root_site_url = config.site_url
+        self._content_languages: dict[str, Language] = {}
+        self._translated: dict[str, set[str]] = {}
+
+    def __repr__(self):
+        return f"{type(self).__name__}(language={self.language.code!r}, prefix={self.prefix!r})"
+
+    language: Language
+    """The language of the site: of its chrome, and of its pages where they are translated."""
+
+    languages: list[Language]
+    """All languages of the site, the default one first."""
+
+    prefix: str
+    """The path of this site within the whole site: `'<code>/'`, or `''` for the root copy."""
+
+    @property
+    def is_root(self) -> bool:
+        """Whether this is the default language's copy at the root of the site."""
+        return not self.prefix
+
+    def language_dir(self, language: Language) -> str:
+        """The directory holding the pages of `language`."""
+        return os.path.join(self._root_docs_dir, language.code)
+
+    @contextlib.contextmanager
+    def configure(self, config: MkDocsConfig) -> Iterator[None]:
+        """
+        Point the config at this site for the duration of its build, then restore it.
+
+        Within the block, `docs_dir` is the language's directory, `site_dir` and `site_url`
+        point at this site, and the theme's locale is the site's language.
+        """
+        saved = {key: config[key] for key in ('docs_dir', 'site_dir', 'site_url', 'nav')}
+        saved_locale = config.theme['locale']
+        try:
+            config.docs_dir = self.language_dir(self.language)
+            config.site_dir = os.path.join(self._root_site_dir, self.prefix)
+            if self._root_site_url:
+                config.site_url = urljoin(self._root_site_url, self.prefix)
+            config.theme['locale'] = localization.parse_locale(self.language.code)
+            yield
+        finally:
+            for key, value in saved.items():
+                config[key] = value
+            config.theme['locale'] = saved_locale
+
+    def collect_files(
+        self,
+        config: MkDocsConfig,
+        *,
+        inclusion: Callable[[InclusionLevel], bool] = InclusionLevel.is_included,
+    ) -> Files:
+        """
+        Return the files of this site: the language's own files, completed from the others.
+
+        For each path, the file comes from the first language that has it, in this order: the
+        site's language, the default language, then the others as declared. A file that would
+        not be built (per `inclusion`, e.g. a draft translation) gives way to one that would.
+        """
+        # Exclusion patterns (`exclude_docs`, `draft_docs`, `not_in_nav`) keep their meaning of
+        # paths within the docs dir, so `fr/guide.md` is a file of `fr` and `guide.md` of any.
+        own_files = {
+            lang.code: get_files(
+                config, docs_dir=self.language_dir(lang), path_prefix=f'{lang.code}/'
+            )
+            if os.path.isdir(self.language_dir(lang))
+            else Files([])
+            for lang in self.languages
+        }
+        self._translated = {
+            code: {f.dest_uri for f in files.documentation_pages(inclusion=inclusion)}
+            for code, files in own_files.items()
+        }
+        chain = [self.language, *(lang for lang in self.languages if lang != self.language)]
+
+        chosen: dict[str, File] = {}
+        taken_dest_uris: set[str] = set()
+        self._content_languages = {}
+        for built in (True, False):
+            for lang in chain:
+                for file in own_files[lang.code]:
+                    if bool(inclusion(file.inclusion)) is not built:
+                        continue
+                    if file.src_uri in chosen or file.dest_uri in taken_dest_uris:
+                        continue
+                    # Paths in the repository are relative to the root docs_dir.
+                    file.edit_uri = f'{lang.code}/{file.src_uri}'
+                    chosen[file.src_uri] = file
+                    taken_dest_uris.add(file.dest_uri)
+                    self._content_languages[file.src_uri] = lang
+        files = Files(sorted(chosen.values(), key=file_sort_key))
+
+        pages = files.documentation_pages(inclusion=inclusion)
+        untranslated = sum(1 for f in pages if self.content_language(f) != self.language)
+        if untranslated:
+            log.info(
+                f"{untranslated} of {len(pages)} pages have no '{self.language.code}' "
+                "translation, and are shown in another language."
+            )
+        return files
+
+    def check_conflicts(self, files: Files) -> None:
+        """Fail if a file of the root copy would be written into the site of a language."""
+        if not self.is_root:
+            return
+        prefixes = tuple(f'{lang.code}/' for lang in self.languages)
+        conflicts = sorted(f.src_uri for f in files if f.dest_uri.startswith(prefixes))
+        if conflicts:
+            raise BuildError(
+                f"The default language '{self.language.code}' has files that would be served at "
+                "the same location as the site of a language (the default language is also "
+                "served at the site root). Rename or move them:\n  - " + '\n  - '.join(conflicts)
+            )
+
+    def content_language(self, file: File) -> Language:
+        """The language that `file` is written in (files added by plugins count as translated)."""
+        return self._content_languages.get(file.src_uri, self.language)
+
+    def localize_nav(self, nav_config, files: Files, config: MkDocsConfig):
+        """
+        Adapt the `nav` config to this site's language.
+
+        Titles in the `nav` config are taken to be in the default language. In any other
+        language, a page that is translated is titled by its own title instead.
+        """
+        if nav_config is None or self.language.is_default:
+            return nav_config
+
+        def is_translated(path: str) -> bool:
+            if (
+                path.startswith('/')
+                and config.validation.nav.absolute_links
+                is _AbsoluteLinksValidationValue.RELATIVE_TO_DOCS
+            ):
+                path = path.lstrip('/')
+            file = files.get_file_from_path(path)
+            return file is not None and self.content_language(file) == self.language
+
+        def localize(item):
+            if isinstance(item, list):
+                return [localize(child) for child in item]
+            if isinstance(item, dict):
+                if len(item) > 1:  # Same as a list of the items, which can then lose titles.
+                    return [localize({title: value}) for title, value in item.items()]
+                for title, value in item.items():
+                    if isinstance(value, str):
+                        return value if is_translated(value) else item
+                    return {title: localize(value)}  # A section.
+            return item
+
+        return localize(nav_config)
+
+    def localize_page(self, page: Page) -> None:
+        """Set the language attributes of `page`, a page of this site."""
+        page.language = self.language
+        page.content_language = self.content_language(page.file)
+        page.alternates = self.alternates(page.url, dest_uri=page.file.dest_uri)
+        if self.is_root and page.canonical_url is not None:
+            # The root copy duplicates the default language's site, which is the canonical one.
+            page.canonical_url = next(a.canonical_url for a in page.alternates if a.active)
+
+    def alternates(self, url: str = '', *, dest_uri: str | None = None) -> list[Alternate]:
+        """
+        Return the versions, in every language, of the page at `url` in this site.
+
+        `dest_uri` identifies the page among each language's own files; without it (for
+        templates, which are rendered in every language) all versions count as translated.
+        """
+        up = '' if self.is_root else '../'
+        result = []
+        for lang in self.languages:
+            active = lang == self.language
+            result.append(
+                Alternate(
+                    language=lang,
+                    url=url if active else f'{up}{lang.code}/{url}',
+                    canonical_url=urljoin(self._root_site_url, f'{lang.code}/{url}')
+                    if self._root_site_url
+                    else None,
+                    active=active,
+                    translated=dest_uri is None or dest_uri in self._translated.get(lang.code, ()),
+                )
+            )
+        return result
+
+
+UNTRANSLATED_NOTICE_TEMPLATE = 'untranslated-notice.html'
+"""The theme template that renders the notice on untranslated pages, if the theme has one."""
+
+_DEFAULT_UNTRANSLATED_NOTICE = (
+    '<div class="mkdocs-untranslated-notice" role="note">'
+    '{% trans language=page.language.name, source=page.content_language.name %}'
+    'This page has not been translated into {{ language }} yet. It is shown in {{ source }}.'
+    '{% endtrans %}'
+    '</div>'
+)
+
+
+def mark_untranslated(page: Page, env: jinja2.Environment, context: TemplateContext) -> str:
+    """
+    Return the content of an untranslated `page`, preceded by a notice in the site's language.
+
+    The notice is the theme's `untranslated-notice.html` template if it has one, rendered with
+    the page's context. The content itself is marked with the language it is written in.
+    """
+    try:
+        template = env.get_template(UNTRANSLATED_NOTICE_TEMPLATE)
+    except jinja2.TemplateNotFound:
+        template = env.from_string(_DEFAULT_UNTRANSLATED_NOTICE)
+    notice = template.render(context)
+    source = page.content_language
+    assert source is not None
+    return (
+        notice
+        + f'<div lang="{escape(source.html_lang)}" dir="{escape(source.direction)}">'
+        + (page.content or '')
+        + '</div>'
+    )
