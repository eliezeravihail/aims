+class LanguagesValue(Config):
+    """The languages of a multi-language site (the value of the `languages` config)."""
+
+    default = Type(str)
+    """The code of the default language. Its pages are also served at the site root,
+    and they stand in for pages that another language has not translated."""
+    others = ListOfItems(Type(str), default=[])
+    """The codes of the other languages, in the order they are offered to readers."""
+
+    @property
+    def codes(self) -> list[str]:
+        """All language codes, the default one first."""
+        return [self.default, *self.others]
+
+
+_LANGUAGE_CODE_CHARS = frozenset(string.ascii_letters + string.digits + '_')
+
+
+class Languages(SubConfig[LanguagesValue]):
+    """
+    The `languages` config: turns the site into a multi-language site when set.
+
+    Each code must be a valid locale identifier (`fr`, `pt_BR`); it doubles as the
+    name of the language's directory under `docs_dir` and as its URL prefix.
+    """
+
+    def __init__(self) -> None:
+        super().__init__()
+        self.default = None
+
+    def validate(self, value: object) -> LanguagesValue | None:  # type: ignore[override]
+        if value is None:
+            return None
+        return self.run_validation(value)
+
+    def run_validation(self, value: object) -> LanguagesValue:
+        if not isinstance(value, dict):
+            raise ValidationError(
+                "Expected a mapping with a 'default' language and optionally a list of 'others', "
+                f"but received: {type(value)}"
+            )
+        languages = super().run_validation(value)
+        seen: set[str] = set()
+        for code in languages.codes:
+            if code in seen:
+                raise ValidationError(f"The language '{code}' is listed more than once.")
+            seen.add(code)
+            if not code or not set(code) <= _LANGUAGE_CODE_CHARS:
+                raise ValidationError(
+                    f"Invalid language code '{code}': expected a locale identifier such as 'fr' "
+                    "or 'pt_BR' (it is also used as a directory name and as a URL path segment)."
+                )
+            try:
+                localization.parse_locale(code)
+            except ValidationError as e:
+                raise ValidationError(f"Invalid language code '{code}'. {e}")
+        return languages
+
+    def post_validation(self, config: Config, key_name: str) -> None:
+        languages = config[key_name]
+        if languages is None:
+            return
+        default_dir = os.path.join(config['docs_dir'], languages.default)
+        if not os.path.isdir(default_dir):
+            raise ValidationError(
+                f"The directory of the default language '{languages.default}' does not exist: "
+                f"'{default_dir}'. The pages of each language go under '<docs_dir>/<language>/'."
+            )
+
+
