+class LanguageSiteTests(unittest.TestCase):
+    @tempdir(['en/index.md', 'fr/index.md'])
+    def test_config_per_language(self, docs_dir):
+        cfg = load_config(
+            docs_dir=docs_dir,
+            site_url='https://example.com/',
+            languages={'default': 'en', 'others': ['fr']},
+            plugins=['search'],
+            theme={'name': 'mkdocs', 'locale': 'de'},
+        )
+        en, fr, root = LanguageSite.all_for(cfg)
+        self.assertEqual((en.language.code, en.path, en.at_root), ('en', 'en/', False))
+        self.assertEqual((fr.language.code, fr.path, fr.at_root), ('fr', 'fr/', False))
+        self.assertEqual((root.language.code, root.path, root.at_root), ('en', '', True))
+
+        fr_cfg = fr.config_for(cfg)
+        self.assertIs(fr_cfg._language_site, fr)
+        self.assertEqual(fr_cfg.site_dir, os.path.join(cfg.site_dir, 'fr'))
+        self.assertEqual(fr_cfg.site_url, 'https://example.com/fr/')
+        self.assertEqual(str(fr_cfg.theme.locale), 'fr')
+        self.assertEqual(fr_cfg.docs_dir, cfg.docs_dir)
+        # The builds of the languages do not share their plugins.
+        self.assertIsNot(fr_cfg.plugins['search'], cfg.plugins['search'])
+        self.assertIsNot(fr_cfg.plugins['search'], en.config_for(cfg).plugins['search'])
+        # The config of the whole site is left as it was.
+        self.assertIsNone(cfg._language_site)
+        self.assertEqual(str(cfg.theme.locale), 'de')
+
+        root_cfg = root.config_for(cfg)
+        self.assertEqual(root_cfg.site_dir, cfg.site_dir)
+        self.assertEqual(root_cfg.site_url, 'https://example.com/')
+
+    def test_language(self):
+        lang = Language('he', is_default=False)
+        self.assertEqual(lang.name, 'עברית')
+        self.assertEqual(lang.direction, 'rtl')
+        self.assertEqual(lang.tag, 'he')
+        self.assertEqual(str(lang), 'he')
+        lang = Language('pt_BR', is_default=True)
+        self.assertEqual(lang.tag, 'pt-BR')
+        self.assertEqual(lang.direction, 'ltr')
+        self.assertTrue(lang.name.startswith('Português'))
