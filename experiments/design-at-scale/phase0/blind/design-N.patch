@@ -0,0 +1,507 @@
+"""
+Multi-language sites.
+
+A site that declares `languages` in its config keeps the pages of each language in
+`docs_dir/<code>/`. It is built as one complete, ordinary MkDocs site per language, at
+`site_dir/<code>/`, plus a copy of the default language's site at the root of `site_dir`.
+Each of those builds is described by a `LanguageSite`.
+
+Every language site contains every page: where a language has no translation of a page, its
+site renders the page from the default language (or, failing that, from the first other
+language that has it), in that language's chrome and with a notice that it is not translated.
+The same applies to the other (non-Markdown) files in the language directories. Files in
+`docs_dir` outside the language directories are shared by all languages.
+
+Links between files keep their usual meaning - a relative path from one source file to another -
+and resolve within the language being built, so a link from an untranslated page leads to the
+page in the reader's language.
+"""
+
+from __future__ import annotations
+
+import contextlib
+import logging
+import os
+from dataclasses import dataclass
+from typing import TYPE_CHECKING, Callable, Iterable, Iterator, Sequence
+from urllib.parse import urljoin
+
+from jinja2.exceptions import TemplateNotFound
+
+from mkdocs.localization import Locale, has_babel, parse_locale
+from mkdocs.structure.files import File, Files, InclusionLevel, file_sort_key
+from mkdocs.utils import nest_paths
+
+if TYPE_CHECKING:
+    import jinja2
+
+    from mkdocs.config.defaults import MkDocsConfig
+    from mkdocs.structure.pages import Page
+    from mkdocs.utils.templates import TemplateContext
+
+
+log = logging.getLogger(__name__)
+
+
+# Languages written right-to-left (ISO 639 codes).
+_RTL_LANGUAGES = frozenset(
+    {'ar', 'arc', 'ckb', 'dv', 'fa', 'he', 'iw', 'ks', 'ps', 'sd', 'syr', 'ug', 'ur', 'yi'}
+)
+
+# Native names of common languages, used when Babel is not installed.
+_NATIVE_NAMES = {
+    'af': 'Afrikaans',
+    'ar': 'العربية',
+    'bg': 'Български',
+    'bn': 'বাংলা',
+    'ca': 'Català',
+    'cs': 'Čeština',
+    'cy': 'Cymraeg',
+    'da': 'Dansk',
+    'de': 'Deutsch',
+    'el': 'Ελληνικά',
+    'en': 'English',
+    'eo': 'Esperanto',
+    'es': 'Español',
+    'et': 'Eesti',
+    'eu': 'Euskara',
+    'fa': 'فارسی',
+    'fi': 'Suomi',
+    'fr': 'Français',
+    'ga': 'Gaeilge',
+    'gl': 'Galego',
+    'he': 'עברית',
+    'hi': 'हिन्दी',
+    'hr': 'Hrvatski',
+    'hu': 'Magyar',
+    'hy': 'Հայերեն',
+    'id': 'Bahasa Indonesia',
+    'is': 'Íslenska',
+    'it': 'Italiano',
+    'ja': '日本語',
+    'ka': 'ქართული',
+    'kk': 'Қазақ тілі',
+    'ko': '한국어',
+    'lt': 'Lietuvių',
+    'lv': 'Latviešu',
+    'mk': 'Македонски',
+    'ms': 'Bahasa Melayu',
+    'nb': 'Norsk bokmål',
+    'nl': 'Nederlands',
+    'nn': 'Norsk nynorsk',
+    'no': 'Norsk',
+    'pl': 'Polski',
+    'pt': 'Português',
+    'ro': 'Română',
+    'ru': 'Русский',
+    'sk': 'Slovenčina',
+    'sl': 'Slovenščina',
+    'sq': 'Shqip',
+    'sr': 'Српски',
+    'sv': 'Svenska',
+    'sw': 'Kiswahili',
+    'ta': 'தமிழ்',
+    'te': 'తెలుగు',
+    'th': 'ไทย',
+    'tr': 'Türkçe',
+    'uk': 'Українська',
+    'ur': 'اردو',
+    'uz': 'Oʻzbekcha',  # noqa: RUF001
+    'vi': 'Tiếng Việt',
+    'yi': 'ייִדיש',
+    'zh': '中文',
+}
+
+
+def _parse(code: str) -> Locale:
+    return parse_locale(code.replace('-', '_'))
+
+
+def _babel_name(code: str, in_code: str) -> str | None:
+    if not has_babel:  # pragma: no cover
+        return None
+    try:
+        return _parse(code).get_display_name(_parse(in_code)) or None  # type: ignore[union-attr]
+    except Exception:
+        return None
+
+
+def _fallback_name(code: str) -> str:
+    locale = _parse(code)
+    name = _NATIVE_NAMES.get(locale.language.lower(), code)
+    if locale.territory:
+        name += f' ({locale.territory})'
+    return name
+
+
+def _direction(code: str) -> str:
+    locale = _parse(code)
+    if has_babel:
+        try:
+            return 'rtl' if locale.character_order == 'right-to-left' else 'ltr'  # type: ignore[union-attr]
+        except Exception:  # pragma: no cover
+            pass
+    return 'rtl' if locale.language.lower() in _RTL_LANGUAGES else 'ltr'
+
+
+@dataclass(frozen=True)
+class Language:
+    """One of the languages of a multi-language site."""
+
+    code: str
+    """The code as declared in the config, e.g. `fr` or `pt_BR`. It is also the name of the
+    language's directory in `docs_dir` and of its path in the built site."""
+
+    is_default: bool
+    """Whether this is the default language."""
+
+    @property
+    def tag(self) -> str:
+        """The IETF (BCP 47) language tag, for `lang` and `hreflang` attributes, e.g. `pt-BR`."""
+        return self.code.replace('_', '-')
+
+    @property
+    def name(self) -> str:
+        """The name of the language in the language itself, e.g. `Français`."""
+        name = _babel_name(self.code, self.code) or _fallback_name(self.code)
+        return name[:1].upper() + name[1:]
+
+    @property
+    def direction(self) -> str:
+        """The writing direction of the language, `ltr` or `rtl`."""
+        return _direction(self.code)
+
+    def name_in(self, other: Language) -> str:
+        """
+        The name of this language as written in `other`, e.g. `anglais` for English in French.
+
+        Without Babel installed, this is the native name of the language.
+        """
+        return _babel_name(self.code, other.code) or _fallback_name(self.code)
+
+    def __str__(self) -> str:
+        return self.code
+
+
+@dataclass(frozen=True)
+class Translation:
+    """The version of a page (or of the site) in one of the languages, as offered to readers."""
+
+    language: Language
+    """The language of this version."""
+
+    url: str
+    """The URL of this version relative to the root of the current language's site (like
+    `page.url`), so templates should pass it through the `url` filter."""
+
+    canonical_url: str | None
+    """The full URL of this version, if `site_url` is set."""
+
+    is_current: bool
+    """Whether this is the version being viewed."""
+
+    is_translated: bool
+    """Whether the page is written in this language. When `False`, this language shows the
+    page from another language, with a notice that it is not translated."""
+
+
+@dataclass
+class _Source:
+    rel_path: str
+    language: Language
+
+
+class LanguageSite:
+    """
+    One of the sites that make up a multi-language site: a language, and where it is built.
+
+    The config of each such build carries it as `config._language_site`.
+    """
+
+    def __init__(self, language: Language, languages: Sequence[Language], *, at_root: bool = False):
+        self.language = language
+        """The language of this site."""
+        self.languages = list(languages)
+        """All the languages of the site, the default one first."""
+        self.at_root = at_root
+        """Whether this is the copy of the default language's site at the root of the site."""
+        self._sources: dict[str, _Source] = {}
+        self._translated: dict[str, set[str]] = {}
+
+    @classmethod
+    def all_for(cls, config: MkDocsConfig) -> list[LanguageSite]:
+        """The sites to build for a config that declares `languages`, the root copy last."""
+        assert config.languages is not None
+        languages = [
+            Language(code, is_default=(code == config.languages.default))
+            for code in config.languages.all
+        ]
+        return [
+            *(cls(language, languages) for language in languages),
+            cls(languages[0], languages, at_root=True),
+        ]
+
+    def __repr__(self) -> str:
+        return f"LanguageSite({self.language.code!r}, path={self.path!r})"
+
+    @property
+    def path(self) -> str:
+        """Where this site is, relative to the root of the whole site: `''` or e.g. `'fr/'`."""
+        return '' if self.at_root else f'{self.language.code}/'
+
+    @property
+    def is_primary(self) -> bool:
+        """Whether this build reports the problems that are the same in every language."""
+        return self.language.is_default and not self.at_root
+
+    def config_for(self, config: MkDocsConfig) -> MkDocsConfig:
+        """Derive the config of this site's build from the config of the whole site."""
+        cfg = config._fresh_copy()
+        cfg._language_site = self
+        # Take these from `config` itself, which `mkdocs serve` modifies after loading it.
+        cfg.site_dir = (
+            os.path.join(config.site_dir, self.language.code) if self.path else config.site_dir
+        )
+        cfg.site_url = urljoin(config.site_url, self.path) if config.site_url else config.site_url
+        cfg.theme['locale'] = _parse(self.language.code)
+        return cfg
+
+    def _order(self, available: Iterable[str]) -> list[str]:
+        """Languages to take a file from, most preferred first."""
+        order = [self.language.code] + [lang.code for lang in self.languages]
+        return [code for code in dict.fromkeys(order) if code in available]
+
+    def localize_files(
+        self,
+        files: Files,
+        config: MkDocsConfig,
+        inclusion: Callable[[InclusionLevel], bool] = InclusionLevel.is_included,
+    ) -> Files:
+        """
+        Turn the files of the whole `docs_dir` into the files of this language's site.
+
+        Each file of a language directory becomes a file of this site, at its path within the
+        language directory, taken from this language if it has it and from another one otherwise.
+        The files outside the language directories are included as they are.
+        """
+        codes = {lang.code: lang for lang in self.languages}
+        by_path: dict[str, dict[str, File]] = {}
+        shared: list[File] = []
+        stray_pages: list[str] = []
+        for file in files:
+            head, sep, rest = file.src_uri.partition('/')
+            if sep and head in codes:
+                by_path.setdefault(rest, {})[head] = file
+            elif file.is_documentation_page():
+                if file.inclusion.is_included():
+                    stray_pages.append(file.src_uri)
+            else:
+                shared.append(file)
+        if stray_pages and self.is_primary:
+            log.warning(
+                "The following pages are not in the directory of any language, "
+                "so they are not part of the site:\n  - " + '\n  - '.join(stray_pages)
+            )
+
+        code = self.language.code
+        self._sources.clear()
+        self._translated.clear()
+        localized: dict[str, File] = {}  # By dest_uri.
+        for rel_path, versions in by_path.items():
+            if next(iter(versions.values())).is_documentation_page():
+                self._translated[rel_path] = {
+                    lang for lang, f in versions.items() if inclusion(f.inclusion)
+                }
+            order = self._order(versions.keys())
+            source_code = next((c for c in order if inclusion(versions[c].inclusion)), order[0])
+            source = versions[source_code]
+
+            file = File(
+                f'{code}/{rel_path}',
+                source.src_dir,
+                config.site_dir,
+                config.use_directory_urls,
+                dest_uri=File(rel_path, None, '', config.use_directory_urls).dest_uri,
+                inclusion=source.inclusion,
+            )
+            if source_code != code:
+                file.abs_src_path = source.abs_src_path
+                file.edit_uri = source.src_uri
+                self._sources[file.src_uri] = _Source(rel_path, codes[source_code])
+
+            other = localized.get(file.dest_uri)
+            if other is not None and self._rank(other) <= self._rank(file):
+                # E.g. 'index.md' in one language and 'README.md' in another:
+                # keep the one from the most preferred language.
+                continue
+            localized[file.dest_uri] = file
+
+        result: list[File] = []
+        for file in shared:
+            other = localized.get(file.dest_uri)
+            if other is None:
+                result.append(file)
+            elif not self.at_root and self.source_language(other) is None:
+                log.warning(
+                    f"Excluding '{file.src_uri}' from the '{code}' site "
+                    f"because it conflicts with '{other.src_uri}'."
+                )
+        result.extend(sorted(localized.values(), key=file_sort_key))
+
+        # At the root, the default language's site sits next to the sites of all languages.
+        conflicting = [f for f in result if f.dest_uri.partition('/')[0] in codes]
+        if conflicting:
+            if self.at_root:
+                result = [f for f in result if f not in conflicting]
+            elif self.is_primary:
+                log.warning(
+                    "The following files are not served at the root of the site, because their "
+                    "paths there are taken by the language sites:\n  - "
+                    + '\n  - '.join(self.real_src_uri(f) for f in conflicting)
+                )
+        return Files(result)
+
+    def _rank(self, file: File) -> int:
+        source = self._sources.get(file.src_uri)
+        code = self.language.code if source is None else source.language.code
+        return self._order(lang.code for lang in self.languages).index(code)
+
+    def real_src_uri(self, file: File) -> str:
+        """The path in `docs_dir` of the file that `file` is rendered from."""
+        source = self._sources.get(file.src_uri)
+        return file.src_uri if source is None else f'{source.language.code}/{source.rel_path}'
+
+    def source_language(self, file: File) -> Language | None:
+        """
+        The language a page of this site is shown in, if it is not translated into this site's
+        language. `None` if it is translated (or is not a page of a language directory).
+        """
+        source = self._sources.get(file.src_uri)
+        return source.language if source is not None else None
+
+    def localize_nav(self, nav_config: list | None, files: Files) -> list:
+        """
+        Turn the `nav` config, whose paths are relative to a language directory, into the nav
+        config of this site. Without a `nav` config, create the default navigation of the site.
+
+        In languages other than the default one, a page that is translated uses its own title
+        rather than the title set in `nav`, which is taken to be in the default language.
+        """
+        prefix = f'{self.language.code}/'
+        if nav_config is None:
+            pages = sorted(files.documentation_pages(), key=file_sort_key)
+            paths = [
+                f.src_uri[len(prefix) :] if f.src_uri.startswith(prefix) else f.src_uri
+                for f in pages
+                if f.inclusion.is_in_nav()
+            ]
+            nav_config = nest_paths(paths)
+
+        def localize_path(path: str) -> str:
+            if files.get_file_from_path(prefix + path) is not None:
+                return prefix + path
+            return path
+
+        def is_translated_page(path: str) -> bool:
+            file = files.get_file_from_path(path)
+            return (
+                file is not None
+                and file.is_documentation_page()
+                and path.startswith(prefix)
+                and self.source_language(file) is None
+            )
+
+        def localize(item):
+            if isinstance(item, str):
+                return localize_path(item)
+            if isinstance(item, list):
+                result = []
+                for sub in item:
+                    if isinstance(sub, dict) and len(sub) == 1:
+                        ((title, value),) = sub.items()
+                        if isinstance(value, str):
+                            path = localize_path(value)
+                            if not self.language.is_default and is_translated_page(path):
+                                result.append(path)
+                            else:
+                                result.append({title: path})
+                            continue
+                    result.append(localize(sub))
+                return result
+            if isinstance(item, dict):
+                return {title: localize(value) for title, value in item.items()}
+            return item
+
+        return localize(nav_config)
+
+    def translations(self, page: Page | None, config: MkDocsConfig) -> list[Translation]:
+        """The versions of `page` (or, without a page, of the site) in every language."""
+        if page is not None:
+            url = page.url
+            rel_path = page.file.src_uri.partition('/')[2]
+            translated_into = self._translated.get(rel_path)
+        else:
+            url = '' if config.use_directory_urls else 'index.html'
+            translated_into = None
+        up = '../' * self.path.count('/')
+        root_url = config.site_url
+        if root_url and self.path:
+            root_url = urljoin(root_url, '../' * self.path.count('/'))
+
+        result = []
+        for lang in self.languages:
+            is_current = lang == self.language
+            path = f'{lang.code}/{url}'
+            result.append(
+                Translation(
+                    language=lang,
+                    url=url if is_current else up + path,
+                    canonical_url=urljoin(root_url, path) if root_url else None,
+                    is_current=is_current,
+                    is_translated=translated_into is None or lang.code in translated_into,
+                )
+            )
+        return result
+
+    def render_untranslated(
+        self, page: Page, source: Language, env: jinja2.Environment, context: TemplateContext
+    ) -> str:
+        """
+        Render the content of a page that is shown untranslated: the theme's template
+        `untranslated.html`, or else a notice followed by the content in its own language.
+        """
+        try:
+            template = env.get_template('untranslated.html')
+        except TemplateNotFound:
+            template = env.from_string(_UNTRANSLATED_TEMPLATE)
+        return template.render(
+            {
+                **context,
+                'source_language': source,
+                'language_name': self.language.name_in(self.language),
+                'source_language_name': source.name_in(self.language),
+            }
+        )
+
+
+_UNTRANSLATED_TEMPLATE = """\
+<div class="mkdocs-untranslated" role="note">
+  {%- trans language=language_name, source_language=source_language_name -%}
+    This page has not been translated into {{ language }} yet, so it is shown in {{ source_language }}.
+  {%- endtrans -%}
+</div>
+<div lang="{{ source_language.tag }}" dir="{{ source_language.direction }}">
+{{ page.content }}
+</div>"""
+
+
+@contextlib.contextmanager
+def quiet() -> Iterator[None]:
+    """Silence the `mkdocs` loggers below errors, for work whose problems are reported elsewhere."""
+    logger = logging.getLogger('mkdocs')
+    level = logger.level
+    logger.setLevel(max(logging.ERROR, logger.getEffectiveLevel()))
+    try:
+        yield
+    finally:
+        logger.setLevel(level)
