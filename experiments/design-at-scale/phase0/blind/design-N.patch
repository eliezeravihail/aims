+class LanguageCode(Type[str]):
+    """
+    A language code such as `en`, `fr` or `pt_BR`.
+
+    The code names the language's directory in `docs_dir`, the language's path in the built
+    site, and the theme locale used for that language, so it must be a valid locale identifier
+    that is also a plain path segment.
+    """
+
+    _pattern = re.compile(r'[A-Za-z]{2,3}(?:[_-][A-Za-z0-9]{2,8})*')
+
+    def __init__(self, **kwargs) -> None:
+        super().__init__(str, **kwargs)
+
+    def run_validation(self, value: object) -> str:
+        if isinstance(value, bool):
+            # YAML 1.1 reads a bare `no` (Norwegian) or `on` as a boolean.
+            raise ValidationError(
+                f"Expected a language code, but got the boolean {value!r}. "
+                "Put the language code in quotes, e.g. 'no'."
+            )
+        code = super().run_validation(value)
+        if not self._pattern.fullmatch(code):
+            raise ValidationError(f"'{code}' is not a valid language code.")
+        localization.parse_locale(code.replace('-', '_'))
+        return code
+
+
+class LanguagesConfig(Config):
+    """The value of the `languages` setting."""
+
+    default = LanguageCode()
+    """The code of the default language, served both at `/<code>/` and at the site root."""
+
+    others = ListOfItems(LanguageCode(), default=[])
+    """The codes of the other languages, in the order they are offered to readers."""
+
+    @property
+    def all(self) -> list[str]:
+        """All language codes, the default one first."""
+        return [self.default, *self.others]
+
+
+class Languages(SubConfig[LanguagesConfig]):
+    """
+    Languages Config Option.
+
+    Declares a multi-language site: a default language and any number of other languages,
+    each with its pages in `docs_dir/<code>/`.
+    """
+
+    def __init__(self) -> None:
+        super().__init__(LanguagesConfig)
+        self.default = None
+
+    def run_validation(self, value: object) -> LanguagesConfig:
+        if not isinstance(value, dict):
+            raise ValidationError(
+                "Expected a mapping with the keys 'default' and 'others', "
+                f"got {Nav._repr_item(value)}"
+            )
+        result = super().run_validation(value)
+        seen: set[str] = set()
+        for code in result.all:
+            # Directory names may be case-insensitive, and 'pt-BR' is the same locale as 'pt_BR'.
+            key = code.lower().replace('-', '_')
+            if key in seen:
