+#!/usr/bin/env python
+from __future__ import annotations
+
+import io
+import json
+import logging
+import os
+import re
+import unittest
+
+from mkdocs.commands import build
+from mkdocs.config import base
+from mkdocs.exceptions import Abort
+from mkdocs.localization import has_babel
+from mkdocs.structure.languages import Language, LanguageSite
+from mkdocs.tests.base import PathAssertionMixin, load_config, tempdir
+
+_PROJECT = {
+    'en/index.md': '# Welcome\n\nRead the [guide](guide.md) and [the setup](guide.md#setup).\n\n![Logo](../img/logo.png)\n',
+    'en/guide.md': '# Guide\n\nThe English guide. Back [home](index.md).\n\n## Setup\n\n![Shot](img/shot.png)\n',
+    'en/more/only-en.md': '# Only in English\n\nSee the [guide](../guide.md).\n',
+    'en/img/shot.png': 'english screenshot',
+    'fr/index.md': '# Bienvenue\n\nLisez le [guide](guide.md).\n',
+    'fr/only-fr.md': '# Seulement en français\n\nUne page française.\n',
+    'fr/img/shot.png': 'capture française',
+    'he/index.md': '# ברוכים הבאים\n\nקראו את [המדריך](guide.md).\n',  # noqa: RUF001
+    'img/logo.png': 'shared logo',
+}
+
+
+def _read(*parts: str) -> str:
+    with open(os.path.join(*parts), encoding='utf-8') as f:
+        return f.read()
+
+
+def _main(html: str) -> str:
+    """The main content of a page built with the `mkdocs` theme."""
+    return html.split('role="main">', 1)[1].split('<footer', 1)[0]
+
+
+def _nav_titles(html: str) -> list[str]:
+    navbar = html.split('<!-- Main navigation -->', 1)[1].split('ms-md-auto', 1)[0]
+    return [t.strip() for t in re.findall(r'<a [^>]*>([^<]+)</a>', navbar)]
+
+
+def _languages_menu(html: str) -> dict[str, str]:
+    menu = html.split('class="fa fa-language"', 1)[1].split('</ul>', 1)[0]
+    links = re.findall(r'<a href="([^"]*)"[^>]* hreflang="([^"]+)"', menu)
+    return {lang: href for href, lang in links}
