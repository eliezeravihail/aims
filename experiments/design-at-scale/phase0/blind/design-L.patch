+"""
+Multi-language sites.
+
+A site that declares `languages` in its config is built as one ordinary MkDocs site per language,
+all from the same `docs_dir`:
+
+    docs/en/...   the default language; every page of the site is defined here
+    docs/fr/...   translations: any subset of the default language's files
+    docs/...      anything else (non-Markdown) is shared by every language
+
+Each language gets its own site at `<site_dir>/<code>/`; the default language is additionally built
+at the root of `site_dir`. Every one of those sites is a *view* of the docs dir in which paths are
+relative to the language directory, the language's own files take precedence, and every page it
+lacks is filled in from the default language (shown with a "not translated" notice). Because every
+view has the same set of pages at the same URLs, the rest of MkDocs (links, navigation, templates,
+plugins such as search) works on each view exactly as it does on a single-language site.
+"""
+
+from __future__ import annotations
+
+import contextlib
+import logging
+import os
+from typing import TYPE_CHECKING, Callable, Iterator, Sequence
+from urllib.parse import urljoin
+
+from mkdocs import localization, utils
+from mkdocs.exceptions import BuildError
+from mkdocs.structure.files import File, Files, InclusionLevel, file_sort_key, get_files
+
+if TYPE_CHECKING:
+    from mkdocs.config.defaults import MkDocsConfig
+    from mkdocs.structure.pages import Page
+
+try:
+    from babel.core import Locale as _BabelLocale
+except ImportError:  # pragma: no cover
+    _BabelLocale = None  # type: ignore[assignment,misc]
+
+
+log = logging.getLogger(__name__)
+
+# Used to pick the text direction when Babel (which knows it for every locale) is not installed.
+_RTL_LANGUAGES = frozenset(
+    {'ar', 'arc', 'ckb', 'dv', 'fa', 'he', 'iw', 'ks', 'ps', 'sd', 'ug', 'ur', 'yi'}
+)
+
+
+class Language:
+    """One of the languages declared in the `languages` config of a multi-language site."""
+
+    def __init__(self, code: str, *, is_default: bool = False) -> None:
+        self.code = code
+        self.is_default = is_default
+        self.name, self.dir = _describe(code)
+
+    code: str
+    """The code of the language as declared in the config (e.g. `pt_BR`).
+
+    It is also the name of the language's directory in `docs_dir` and of its site in `site_dir`."""
+
+    name: str
+    """The name of the language in that language (e.g. `Français`), for use in a language switcher.
+
+    Requires Babel (`pip install mkdocs[i18n]`); without it this is the language code."""
+
+    dir: str
+    """The direction of the language's script: `ltr` or `rtl`. For the HTML `dir` attribute."""
+
+    is_default: bool
+    """Whether this is the default language, the one every page is originally written in."""
+
+    @property
+    def tag(self) -> str:
+        """The language as a BCP 47 tag (e.g. `pt-BR`), for HTML `lang` and `hreflang` attributes."""
+        return self.code.replace('_', '-')
+
+    def __str__(self) -> str:
+        return self.tag
+
+    def __repr__(self) -> str:
+        return f"Language({self.code!r})"
+
+    def __eq__(self, other) -> bool:
+        return isinstance(other, Language) and other.code == self.code
+
+    def __hash__(self) -> int:
+        return hash(self.code)
+
+
+def _describe(code: str) -> tuple[str, str]:
+    """Return the name of the language in itself, and its script direction."""
+    if _BabelLocale is not None:
+        try:
+            locale = _BabelLocale.parse(code, sep='_')
+        except (ValueError, TypeError, LookupError):
+            pass
+        else:
+            name = locale.get_display_name(locale) or code
+            direction = 'rtl' if locale.character_order == 'right-to-left' else 'ltr'
+            return name[:1].upper() + name[1:], direction
+    direction = 'rtl' if code.split('_')[0].lower() in _RTL_LANGUAGES else 'ltr'
+    return code, direction
+
+
+class PageAlternate:
+    """The same page in one of the languages of the site. See `Page.alternates`."""
+
+    def __init__(
+        self,
+        language: Language,
+        url: str,
+        canonical_url: str | None,
+        *,
+        active: bool,
+        is_untranslated: bool,
+    ) -> None:
+        self.language = language
+        self.url = url
+        self.canonical_url = canonical_url
+        self.active = active
+        self.is_untranslated = is_untranslated
+
+    language: Language
+    """The language of this version of the page."""
+
+    url: str
+    """The URL of this version of the page, relative to the root of the current page's site.
+
+    Like `Page.url`, pass it through the `url` template filter: `{{ alternate.url|url }}`."""
+
+    canonical_url: str | None
+    """The full URL of this version of the page. `None` unless `site_url` is set."""
+
+    active: bool
+    """Whether this is the language of the page being rendered."""
+
+    is_untranslated: bool
+    """Whether this language shows the default-language page because it has no translation of it."""
+
+    def __repr__(self) -> str:
+        return f"PageAlternate(language={self.language.code!r}, url={self.url!r})"
+
+
+class LanguageSite:
+    """
+    The site of one language: one of the ordinary MkDocs builds a multi-language site consists of.
+
+    While `activated`, the config describes this site (its `site_dir`, `site_url` and theme locale),
+    `get_files` provides its view of the docs dir, and `set_page_language` gives each of its pages
+    the language information themes need (the language switcher, the "not translated" notice).
+    """
+
+    def __init__(self, language: Language, languages: Sequence[Language], path: str) -> None:
+        self.language = language
+        self.languages = languages
+        self.path = path
+        self._by_code = {lang.code: lang for lang in languages}
+        self._default = languages[0]
+        self._root_site_url: str | None = None
+        # Page key (destination URI) -> codes of the languages the page is written in.
+        self._written_in: dict[str, set[str]] = {}
+
+    language: Language
+    """The language of this site."""
+
+    languages: Sequence[Language]
+    """All languages of the multi-language site, the default one first."""
+
+    path: str
+    """Where the site is, relative to the top of `site_dir` (and of `site_url`): `fr/`, or `''` for
+    the copy of the default language at the root."""
+
+    @property
+    def is_root(self) -> bool:
+        """Whether this is the copy of the default language served at the root of the site."""
+        return not self.path
+
+    def __repr__(self) -> str:
+        return f"LanguageSite(language={self.language.code!r}, path={self.path!r})"
+
+    @contextlib.contextmanager
+    def activated(self, config: MkDocsConfig) -> Iterator[None]:
+        """Point the config at this site for the duration of its build; restore it afterwards."""
+        saved = (config.site_dir, config.site_url, config.theme['locale'], config._language_site)
+        self._root_site_url = config.site_url
+        if self.path:
+            config.site_dir = os.path.join(config.site_dir, self.language.code)
+        if config.site_url:
+            config.site_url = urljoin(config.site_url, self.path)
+        config.theme['locale'] = localization.parse_locale(self.language.code)
+        config._language_site = self
+        try:
+            yield
+        finally:
+            config.site_dir, config.site_url, config.theme['locale'], config._language_site = saved
+
+    def get_files(
+        self,
+        config: MkDocsConfig,
+        inclusion: Callable[[InclusionLevel], bool] = InclusionLevel.is_included,
+    ) -> Files:
+        """
+        Walk the `docs_dir` and return this site's view of it.
+
+        In the view, paths are relative to the language directory. It holds the files shared by all
+        languages, overlaid by the default language's files, overlaid by this language's files.
+        A translated page replaces the default-language page only when both are part of the build
+        (per `inclusion`): the set of pages is always exactly the default language's.
+        """
+        default = self._default.code
+        # A source is a file of the docs dir, with its path relative to its language's directory.
+        shared: list[tuple[str, File]] = []
+        by_language: dict[str, dict[str, tuple[str, File]]] = {
+            lang.code: {} for lang in self.languages
+        }
+        for file in get_files(config):
+            head, sep, rest = file.src_uri.partition('/')
+            if sep and head in by_language:
+                by_language[head][_key(rest, config)] = (rest, file)
+            elif file.is_documentation_page():
+                if file.inclusion.is_included():
+                    log.warning(
+                        f"Doc file '{file.src_uri}' is not in a language directory "
+                        f"({', '.join(f'{code}/' for code in by_language)}), "
+                        f"so it is not included in the site."
+                    )
+            else:
+                shared.append((file.src_uri, file))
+
+        def is_page_in_build(sources: dict[str, tuple[str, File]], key: str) -> bool:
+            file = sources[key][1] if key in sources else None
+            return file is not None and file.is_documentation_page() and inclusion(file.inclusion)
+
+        # Every page of the default language, and the languages it is written in.
+        written_in: dict[str, set[str]] = {
+            key: {code for code, sources in by_language.items() if is_page_in_build(sources, key)}
+            for key in by_language[default]
+            if is_page_in_build(by_language[default], key)
+        }
+        self._written_in = written_in
+
+        view: dict[str, File] = {}
+
+        def add(src_uri: str, file: File, language: str | None) -> None:
+            src_dir = os.path.join(config.docs_dir, language) if language else config.docs_dir
+            view_file = File(
+                src_uri, src_dir, config.site_dir, config.use_directory_urls, inclusion=file.inclusion
+            )
+            view_file.language = language
+            view[view_file.dest_uri] = view_file
+
+        for src_uri, file in shared:
+            add(src_uri, file, None)
+        for src_uri, file in by_language[default].values():
+            add(src_uri, file, default)
+        code = self.language.code
+        if code != default:
+            for key, (src_uri, file) in by_language[code].items():
+                if file.is_documentation_page():
+                    if code in written_in.get(key, ()):
+                        add(src_uri, file, code)
+                    elif inclusion(file.inclusion) and key not in by_language[default]:
+                        log.warning(
+                            f"Doc file '{file.src_uri}' is a translation of "
+                            f"'{default}/{src_uri}', which does not exist, "
+                            f"so it is not included in the site."
+                        )
+                elif inclusion(file.inclusion) or key not in view:
+                    add(src_uri, file, code)
+
+        return Files(sorted(view.values(), key=file_sort_key))
+
+    def check_files(self, files: Files) -> None:
+        """Refuse to build a root site with files where the language sites go."""
+        if not self.is_root:
+            return
+        for file in files:
+            head = file.dest_uri.partition('/')[0]
+            if head in self._by_code:
+                raise BuildError(
+                    f"The file '{file.docs_uri}' would be written to '{file.dest_uri}' at the root of "
+                    f"the site, where the site of the language '{head}' is built. Rename it."
+                )
+
+    def set_page_language(self, page: Page) -> None:
+        """Give a page of this site its language, its content's language, and its alternates."""
+        file = page.file
+        page.language = self.language
+        page.content_language = self._by_code.get(file.language or '', self.language)
+
+        written_in = self._written_in.get(file.dest_uri)
+        alternates = []
+        for lang in self.languages:
+            path = f'{lang.code}/{page.url}'
+            active = lang == self.language
+            alternates.append(
+                PageAlternate(
+                    lang,
+                    page.url if active else utils.get_relative_url(path, self.path),
+                    urljoin(self._root_site_url, path) if self._root_site_url else None,
+                    active=active,
+                    is_untranslated=written_in is not None and lang.code not in written_in,
+                )
+            )
+        page.alternates = alternates
+
+        if page.canonical_url and (self.is_root or page.is_untranslated):
+            # A copy of a default-language page: at the root, which copies the default language's
+            # own site, or standing in for a missing translation. The original is canonical.
+            page.canonical_url = alternates[0].canonical_url
+
+
+def _key(src_uri: str, config: MkDocsConfig) -> str:
+    """Identify a file within a language: pages at the same URL are the same page."""
+    return File(src_uri, None, '', config.use_directory_urls).dest_uri
+
+
+def get_language_sites(config: MkDocsConfig) -> list[LanguageSite]:
+    """
+    Return the sites a multi-language site consists of, in build order.
+
+    The copy of the default language at the root comes first, so that it is built (and its
+    `site_dir` cleaned) before the sites of the individual languages are written inside it.
+    """
+    declared = config.languages
+    assert declared is not None
+    languages = [Language(declared.default, is_default=True)]
+    languages += [Language(code) for code in declared.others]
+    return [LanguageSite(languages[0], languages, '')] + [
+        LanguageSite(lang, languages, f'{lang.code}/') for lang in languages
+    ]
+
+
+@contextlib.contextmanager
+def report_once() -> Iterator[None]:
+    """
+    Drop repeated log messages.
+
+    A multi-language build renders the default-language sources several times (at the root, in the
+    default language's own site, and as the fallback for each untranslated page). Every problem in
+    them is reported identically each time, and should be reported once.
+    """
+    # The first record of each message; it passes the filter of every handler, later ones none.
+    first: dict[tuple[str, int, str], logging.LogRecord] = {}
+
+    def first_time(record: logging.LogRecord) -> bool:
+        key = (record.name, record.levelno, record.getMessage())
+        return first.setdefault(key, record) is record
+
+    handlers = []
+    logger: logging.Logger | None = logging.getLogger('mkdocs')
+    while logger is not None:
+        handlers.extend(logger.handlers)
+        logger = logger.parent if logger.propagate else None
+    for handler in handlers:
+        handler.addFilter(first_time)
+    try:
+        yield
+    finally:
+        for handler in handlers:
+            handler.removeFilter(first_time)
