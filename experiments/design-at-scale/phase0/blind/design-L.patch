+class LanguagesConfig(Config):
+    """The languages of a multi-language site."""
+
+    default = Type(str)
+    """The language every page is written in, served at the root of the site too."""
+
+    others = ListOfItems(Type(str), default=[])
+    """The languages the pages may be translated into."""
+
+    @property
+    def codes(self) -> list[str]:
+        """All language codes, the default one first."""
+        return [self.default, *self.others]
+
+
+class Languages(BaseConfigOption[Union[LanguagesConfig, None]]):
+    """
+    Declares a multi-language site: `{default: en, others: [fr, he]}`.
+
+    Each language is a directory of `docs_dir` named by its code, which must be a valid locale.
+    `None` (the default) is an ordinary single-language site.
+    """
+
+    def pre_validation(self, config: Config, key_name: str):
+        self._config_file_path = config.config_file_path
+
+    def run_validation(self, value: object) -> LanguagesConfig | None:
+        if value is None:
+            return None
+        if not isinstance(value, dict):
+            raise ValidationError(
+                f"Expected a mapping with the keys 'default' and 'others', but a {type(value)} was given."
+            )
+        languages = LanguagesConfig(config_file_path=self._config_file_path)
+        try:
+            languages.load_dict(value)
+            failed, warnings = languages.validate()
+        except ConfigurationError as e:
+            raise ValidationError(str(e))
+        self.warnings.extend(f"Sub-option '{key}': {msg}" for key, msg in warnings)
+        if failed:
+            key, err = failed[0]
+            raise ValidationError(f"Sub-option '{key}': {err}")
+
+        for code in languages.codes:
+            if not code or not all(c in string.ascii_letters + string.digits + '_' for c in code):
+                raise ValidationError(
+                    f"Invalid language code {code!r}: it is used as a directory name and in URLs, "
+                    f"so it must be a locale such as 'fr' or 'pt_BR'."
+                )
+            try:
+                parse_locale(code)
+            except ValidationError as e:
+                raise ValidationError(f"Invalid language code {code!r}: {e}")
+        if duplicates := [code for code, n in Counter(languages.codes).items() if n > 1]:
+            raise ValidationError(f"Languages declared more than once: {', '.join(duplicates)}")
+        return languages
+
+    def post_validation(self, config: Config, key_name: str):
+        languages = config[key_name]
+        if languages is None:
+            return
+        default_dir = os.path.join(config['docs_dir'], languages.default)
+        if not os.path.isdir(default_dir):
+            raise ValidationError(
+                f"The directory of the default language ('{languages.default}') "
+                f"does not exist: '{default_dir}'"
+            )
+        # The site as a whole is in the default language; each language's own build uses its own.
+        config['theme']['locale'] = parse_locale(languages.default)
