@@ -0,0 +1,434 @@
+#!/usr/bin/env python
+from __future__ import annotations
+
+import json
+import os
+import re
+import textwrap
+import unittest
+
+from mkdocs.commands import build
+from mkdocs.config import config_options as c
+from mkdocs.config.base import ValidationError
+from mkdocs.exceptions import Abort
+from mkdocs.structure.languages import Language
+from mkdocs.tests.base import PathAssertionMixin, load_config, tempdir
+
+DOCS = {
+    'en/index.md': '# Welcome\n\nSee [the guide](guide.md).',
+    'en/guide.md': '# Guide\n\nThe zebrafish guide. Then [advanced](advanced.md).',
+    'en/advanced.md': '# Advanced\n\nThe albatross chapter, see [the guide](guide.md#guide).',
+    'en/img/logo.png': 'english logo',
+    'fr/index.md': '# Bienvenue\n\nVoir [le guide](guide.md).',
+    'fr/guide.md': '# Le guide\n\nLe guide du poisson.',
+    'fr/img/logo.png': 'logo français',
+    'he/index.md': '# ברוכים הבאים',
+    'css/extra.css': 'body {}',
+}
+LANGUAGES = {'default': 'en', 'others': ['fr', 'he']}
+
+
+def read(*parts: str) -> str:
+    with open(os.path.join(*parts), encoding='utf-8') as f:
+        return f.read()
+
+
+def links(html: str) -> dict[str, str]:
+    """The language switcher of a page: {language: href}."""
+    return dict(
+        (lang, href)
+        for href, lang in re.findall(r'<a href="([^"]*)" hreflang="[^"]*" lang="([^"]*)"', html)
+    )
+
+
+class LanguagesConfigTests(unittest.TestCase):
+    @tempdir(files=['en/index.md'])
+    def test_valid(self, docs_dir):
+        cfg = load_config(docs_dir=docs_dir, languages={'default': 'en', 'others': ['fr', 'pt_BR']})
+        self.assertEqual(cfg.languages.default, 'en')
+        self.assertEqual(cfg.languages.others, ['fr', 'pt_BR'])
+        self.assertEqual(cfg.languages.codes, ['en', 'fr', 'pt_BR'])
+
+    @tempdir(files=['fr/index.md'])
+    def test_theme_locale_is_default_language(self, docs_dir):
+        cfg = load_config(docs_dir=docs_dir, languages={'default': 'fr'}, theme={'name': 'mkdocs'})
+        self.assertEqual(cfg.languages.others, [])
+        self.assertEqual(str(cfg.theme.locale), 'fr')
+
+    def test_absent(self):
+        cfg = load_config()
+        self.assertIsNone(cfg.languages)
+
+    def _validate(self, docs_dir, value):
+        option = c.Languages()
+        cfg = {'docs_dir': docs_dir, 'languages': value}
+
+        class FakeConfig(dict):
+            config_file_path = None
+
+        cfg = FakeConfig(cfg)
+        option.pre_validation(cfg, 'languages')
+        cfg['languages'] = option.validate(value)
+        option.post_validation(cfg, 'languages')
+        return cfg['languages']
+
+    @tempdir(files=['en/index.md'])
+    def test_invalid(self, docs_dir):
+        for value, error in [
+            (['en', 'fr'], "Expected a mapping with the keys 'default' and 'others'"),
+            ({'others': ['fr']}, "Sub-option 'default': Required configuration not provided."),
+            ({'default': 'en', 'others': 'fr'}, "Sub-option 'others': Expected a list"),
+            ({'default': 'en', 'others': ['fr', 'fr']}, "Languages declared more than once: fr"),
+            ({'default': 'en', 'others': ['en']}, "Languages declared more than once: en"),
+            ({'default': 'en', 'others': ['../fr']}, "Invalid language code '../fr'"),
+            ({'default': 'en', 'others': ['f1']}, "Invalid language code 'f1'"),
+            ({'default': 'de'}, "The directory of the default language ('de') does not exist"),
+        ]:
+            with self.subTest(value=value):
+                with self.assertRaisesRegex(ValidationError, re.escape(error)):
+                    self._validate(docs_dir, value)
+
+
+class LanguageTests(unittest.TestCase):
+    def test_language(self):
+        he = Language('he')
+        self.assertEqual(he.dir, 'rtl')
+        self.assertFalse(he.is_default)
+        self.assertEqual(Language('en', is_default=True).dir, 'ltr')
+        self.assertEqual(Language('pt_BR').tag, 'pt-BR')
