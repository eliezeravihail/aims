+class Languages(BaseConfigOption[languages.Languages]):
+    """
+    Languages Config Option.
+
+    Declares the languages of a multi-language site: a mapping with the `default` language code
+    and a list of `others`. Each language's files are in the directory of that name in `docs_dir`.
+    """
+
+    def run_validation(self, value: object) -> languages.Languages:
+        if not isinstance(value, dict):
+            raise ValidationError(
+                f"Expected a mapping with the keys 'default' and 'others', got {type(value)}."
+            )
+        unknown = sorted(str(key) for key in value if key not in ('default', 'others'))
+        if unknown:
+            raise ValidationError(
+                f"Unrecognised key(s): {', '.join(unknown)}. Expected 'default' and 'others'."
+            )
+        default = value.get('default')
+        if not isinstance(default, str):
+            raise ValidationError("'default' must be set to the code of the default language.")
+        others = value.get('others')
+        if others is None:
+            others = []
+        if not isinstance(others, list):
+            raise ValidationError("'others' must be a list of language codes.")
+        return languages.Languages(default, others)
+
+    def post_validation(self, config: Config, key_name: str):
+        value: languages.Languages | None = config[key_name]
+        if value is None:
+            return
+        path = os.path.join(config['docs_dir'], value.default.code)
+        if not os.path.isdir(path):
+            raise ValidationError(
+                f"The directory of the default language, '{path}', does not exist."
+            )
+
+
 class Private(Generic[T], BaseConfigOption[T]):
