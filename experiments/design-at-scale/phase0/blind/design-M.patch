+#!/usr/bin/env python
+from __future__ import annotations
+
+import contextlib
+import json
+import os
+import textwrap
+import unittest
+from pathlib import Path
+
+from mkdocs import languages
+from mkdocs.commands import build
+from mkdocs.config.defaults import MkDocsConfig
+from mkdocs.exceptions import Abort
+from mkdocs.tests.base import PathAssertionMixin, load_config, tempdir
+
+NOTICE = 'This page has not been translated yet. It is shown in its original language.'
+
+DOCS = {
+    'en/index.md': '# Welcome\n\nRead the [guide](guide.md).\n\n![Shot](img/shot.png)',
+    'en/guide.md': '# Guide\n\nEnglish guide text. Back [home](index.md).',
+    'en/about.md': '# About\n\nAbout us, in English.',
+    'en/img/shot.png': 'en-shot',
+    'fr/index.md': '# Bienvenue\n\nLisez le [guide](guide.md).\n\n![Capture](img/shot.png)',
+    'fr/guide.md': '# Le guide\n\nTexte du guide.',
+    'fr/img/shot.png': 'fr-shot',
+    'img/logo.png': 'logo',
+}
+
+
+def read(*parts: str) -> str:
+    return Path(*parts).read_text(encoding='utf-8')
+
+
+class LanguageTests(unittest.TestCase):
+    def test_attributes(self):
+        lang = languages.Language('fr')
+        self.assertEqual(lang.code, 'fr')
+        self.assertEqual(lang.hreflang, 'fr')
+        self.assertEqual(lang.name, 'Français')
+        self.assertEqual(lang.dir, 'ltr')
+        self.assertFalse(lang.is_default)
+        self.assertEqual(str(lang), 'fr')
+
+    def test_rtl(self):
+        self.assertEqual(languages.Language('he').dir, 'rtl')
+        self.assertEqual(languages.Language('ar').dir, 'rtl')
+
+    def test_territory(self):
+        lang = languages.Language('pt-BR')
+        self.assertEqual(lang.code, 'pt-BR')
+        self.assertEqual(lang.hreflang, 'pt-BR')
+        self.assertEqual(str(lang.locale), 'pt_BR')
+        self.assertEqual(languages.Language('pt_BR').hreflang, 'pt-BR')
+
+    def test_invalid_codes(self):
+        for code in ('', 'e', 'english', 'en/fr', '../en', 'en-', 5, None):
+            with self.subTest(code=code):
+                with self.assertRaises(languages.ValidationError):
+                    languages.Language(code)  # type: ignore[arg-type]
+
+    def test_languages(self):
+        langs = languages.Languages('en', ['fr', 'he'])
+        self.assertEqual(langs.codes, ['en', 'fr', 'he'])
+        self.assertEqual(langs.default, languages.Language('en'))
+        self.assertTrue(langs.default.is_default)
+        self.assertEqual([x.is_default for x in langs], [True, False, False])
+        self.assertEqual(len(langs), 3)
+
+    def test_duplicates(self):
+        for default, others in (('en', ['en']), ('en', ['fr', 'fr']), ('pt-BR', ['pt_BR'])):
+            with self.subTest(default=default, others=others):
