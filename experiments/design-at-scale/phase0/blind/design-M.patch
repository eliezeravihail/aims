diff --git a/judge/design-M/mkdocs/languages.py b/judge/design-M/mkdocs/languages.py
new file mode 100644
index 0000000..92ad66f
--- /dev/null
+++ b/judge/design-M/mkdocs/languages.py
@@ -0,0 +1,535 @@
+"""
+Documentation sites written in several languages.
+
+A site declares its languages in `mkdocs.yml`:
+
+    languages:
+      default: en
+      others: [fr, he]
+
+and keeps each language's files under `docs_dir/<code>/`. Everything else in `docs_dir` is shared
+by all languages (images, stylesheets and the like).
+
+The site is then built as several complete sites, one per *language site*:
+
+*   the default language at the root of `site_dir`, and
+*   every language, the default included, at `site_dir/<code>/`.
+
+Each language site is an ordinary MkDocs build: it has its own config (derived from the user's by
+`config_for_site`, with its own `site_dir`, `site_url` and theme locale), its own files, navigation,
+plugin run and search index. Its files form a *virtual docs dir* (`get_site_files`) in which the
+language's directory is the root, so paths in `nav`, `exclude_docs`, links between pages etc. are
+all written relative to a language's directory, the same for every language. In that virtual docs
+dir, every page of every language exists: a page the language lacks is taken from the default
+language (or, failing that, the first other language that has it) and marked as untranslated.
+"""
+
+from __future__ import annotations
+
+import copy
+import logging
+import os
+import posixpath
+import re
+from collections import UserDict
+from contextlib import contextmanager
+from typing import TYPE_CHECKING, Callable, Iterator, NamedTuple, Sequence
+from urllib.parse import urljoin
+
+import jinja2
+from markupsafe import Markup
+
+from mkdocs import localization
+from mkdocs.config.base import ValidationError
+from mkdocs.exceptions import BuildError
+
+if TYPE_CHECKING:
+    from mkdocs.config.defaults import MkDocsConfig
+    from mkdocs.structure.files import File
+    from mkdocs.structure.nav import Navigation
+    from mkdocs.structure.pages import Page
+    from mkdocs.utils.templates import TemplateContext
+
+
+log = logging.getLogger(__name__)
+
+# A language code is used as a directory name and a URL segment, so keep it to the safe subset of
+# BCP 47 / POSIX locale identifiers: "fr", "pt-BR", "pt_BR", "zh-Hant".
+_CODE_RE = re.compile(r'[A-Za-z]{2,3}(?:[-_][A-Za-z0-9]{2,8})*')
+
+# Used only when Babel (which knows about every language) is not installed.
+_RTL_LANGUAGES = frozenset(
+    {'ar', 'arc', 'ckb', 'dv', 'fa', 'he', 'iw', 'ks', 'ku', 'ps', 'sd', 'ug', 'ur', 'yi'}
+)
+# fmt: off
+_NATIVE_NAMES = {
+    'ar': 'العربية', 'bg': 'Български', 'bn': 'বাংলা', 'ca': 'Català', 'cs': 'Čeština',
+    'da': 'Dansk', 'de': 'Deutsch', 'el': 'Ελληνικά', 'en': 'English', 'es': 'Español',
+    'et': 'Eesti', 'eu': 'Euskara', 'fa': 'فارسی', 'fi': 'Suomi', 'fr': 'Français',
+    'ga': 'Gaeilge', 'gl': 'Galego', 'he': 'עברית', 'hi': 'हिन्दी', 'hr': 'Hrvatski',
+    'hu': 'Magyar', 'hy': 'Հայերեն', 'id': 'Indonesia', 'is': 'Íslenska', 'it': 'Italiano',
+    'ja': '日本語', 'ka': 'ქართული', 'kk': 'Қазақ тілі', 'ko': '한국어', 'lt': 'Lietuvių',
+    'lv': 'Latviešu', 'ms': 'Melayu', 'nb': 'Norsk bokmål', 'nl': 'Nederlands',
+    'nn': 'Norsk nynorsk', 'no': 'Norsk', 'pl': 'Polski', 'pt': 'Português', 'ro': 'Română',
+    'ru': 'Русский', 'sk': 'Slovenčina', 'sl': 'Slovenščina', 'sr': 'Српски', 'sv': 'Svenska',
+    'sw': 'Kiswahili', 'ta': 'தமிழ்', 'th': 'ไทย', 'tr': 'Türkçe', 'uk': 'Українська',
+    'ur': 'اردو', 'vi': 'Tiếng Việt', 'zh': '中文',
+}
+# fmt: on
+
+
+class Language:
+    """One of the languages a site is written in."""
+
+    def __init__(self, code: str, *, is_default: bool = False) -> None:
+        if not isinstance(code, str) or not _CODE_RE.fullmatch(code):
+            raise ValidationError(
+                f"Invalid language code {code!r}: expected a code such as 'en', 'fr' or 'pt-BR'."
+            )
+        self.code = code
+        self.locale = localization.parse_locale(code.replace('-', '_'))
+        self.is_default = is_default
+
+    code: str
+    """The code as declared: the name of the language's directory in `docs_dir` and of its URL
+    segment in the built site."""
+
+    locale: localization.Locale
+    """The locale that the theme is rendered in for this language."""
+
+    is_default: bool
+    """Whether this is the site's default language."""
+
+    @property
+    def hreflang(self) -> str:
+        """The code in the form HTML expects (BCP 47), for `lang` and `hreflang` attributes."""
+        return self.code.replace('_', '-')
+
+    @property
+    def name(self) -> str:
+        """The language's name in the language itself, e.g. "Français"."""
+        get_display_name = getattr(self.locale, 'get_display_name', None)
+        if get_display_name is not None:
+            name = get_display_name(self.locale)
+        else:
+            name = _NATIVE_NAMES.get(self.locale.language)
+            if name and self.locale.territory:
+                name += f' ({self.locale.territory})'
+        if not name:
+            return self.code
+        return name[:1].upper() + name[1:]
+
+    @property
+    def dir(self) -> str:
+        """The direction of the language's script: 'ltr' or 'rtl'."""
+        order = getattr(self.locale, 'character_order', None)
+        if order is not None:
+            return 'rtl' if order == 'right-to-left' else 'ltr'
+        return 'rtl' if self.locale.language in _RTL_LANGUAGES else 'ltr'
+
+    def __eq__(self, other) -> bool:
+        return isinstance(other, Language) and self.code == other.code
+
+    def __hash__(self) -> int:
+        return hash(self.code)
+
+    def __str__(self) -> str:
+        return self.code
+
+    def __repr__(self) -> str:
+        return f"Language({self.code!r}{', is_default=True' if self.is_default else ''})"
+
+
+class Languages(Sequence[Language]):
+    """The value of the `languages` config option: the default language, then the others."""
+
+    def __init__(self, default: str, others: Sequence[str] = ()) -> None:
+        self.default = Language(default, is_default=True)
+        self.others = [Language(code) for code in others]
+        seen: set[str] = set()
+        for language in self:
+            key = language.hreflang.lower()
+            if key in seen:
+                raise ValidationError(f"Language '{language.code}' is declared more than once.")
+            seen.add(key)
+
+    default: Language
+    others: list[Language]
+
+    @property
+    def codes(self) -> list[str]:
+        return [language.code for language in self]
+
+    def __getitem__(self, index):
+        return [self.default, *self.others][index]
+
+    def __len__(self) -> int:
+        return 1 + len(self.others)
+
+    def __repr__(self) -> str:
+        return f"Languages(default={self.default.code!r}, others={[x.code for x in self.others]!r})"
+
+
+class LanguageSite:
+    """
+    One of the complete sites that a multi-language site is built as.
+
+    Either a language's site at `<code>/`, or the default language's copy at the root.
+    """
+
+    def __init__(self, languages: Languages, language: Language, *, is_root: bool = False) -> None:
+        if is_root and not language.is_default:
+            raise ValueError("Only the default language is built at the root of the site.")
+        self.languages = languages
+        self.language = language
+        self.is_root = is_root
+        self.untranslated: dict[str, Language] = {}
+
+    languages: Languages
+    """All the languages of the site."""
+
+    language: Language
+    """The language of this site: of its navigation, labels and, where translated, pages."""
+
+    is_root: bool
+    """Whether this is the default language's copy at the root of the site."""
+
+    untranslated: dict[str, Language]
+    """The pages (by `src_uri`) that this language lacks, mapped to the language they are shown in.
+
+    Populated by `get_site_files`."""
+
+    @property
+    def path(self) -> str:
+        """Where this site is in the whole site: '' for the root, else e.g. 'fr/'."""
+        return '' if self.is_root else self.language.code + '/'
+
+    def url_to(self, other: LanguageSite, url: str) -> str:
+        """Return the URL, relative to this site's root, of the page `url` of site `other`."""
+        up = '' if self.is_root else '../'
+        return up + other.path + url
+
+    def __repr__(self) -> str:
+        return f"LanguageSite({self.language.code!r}{', is_root=True' if self.is_root else ''})"
+
+
+def get_sites(languages: Languages) -> list[LanguageSite]:
+    """
+    Return the sites to build, in the order to build them.
+
+    The root site comes first because it's the one that cleans the whole `site_dir`.
+    """
+    return [
+        LanguageSite(languages, languages.default, is_root=True),
+        *(LanguageSite(languages, language) for language in languages),
+    ]
+
+
+def get_language_site(config: MkDocsConfig) -> LanguageSite | None:
+    """Return the language site that `config` builds, or None if the site has a single language."""
+    return getattr(config, '_language_site', None)
+
+
+def config_for_site(config: MkDocsConfig, site: LanguageSite) -> MkDocsConfig:
+    """
+    Derive the config that builds `site` from the user's config.
+
+    Plugins run their `on_config` event once per language site and are free to modify the config
+    (append to `extra_javascript`, add theme dirs...), so the derived config gets its own copy of
+    every value that is commonly modified in place.
+    """
+    site_config = copy.copy(config)
+    for key, value in config.items():
+        if type(value) in (list, dict, set):
+            site_config[key] = type(value)(value)
+        elif isinstance(value, UserDict):
+            site_config[key] = copy.copy(value)
+    site_config.theme = config.theme._clone()
+    site_config.theme['locale'] = site.language.locale
+    if not site.is_root:
+        site_config.site_dir = os.path.join(config.site_dir, site.language.code)
+        if config.site_url:
+            site_config.site_url = urljoin(config.site_url, site.path)
+    site_config._language_site = site
+    return site_config
+
+
+def get_site_files(config: MkDocsConfig, site: LanguageSite) -> list[File]:
+    """
+    Return the files of the virtual docs dir of `site`.
+
+    Every file is found at its path relative to its language's directory (or to `docs_dir` for the
+    shared files). Where several have the same destination, the first of these wins:
+
+    1. the site's language's own file,
+    2. a shared file,
+    3. the default language's file, then those of the other languages in the declared order.
+
+    Pages obtained from 3. are recorded in `site.untranslated`.
+    """
+    from mkdocs.structure.files import file_sort_key, walk_docs_dir
+
+    docs_dir = config.docs_dir
+    site.untranslated = {}
+    chosen: dict[str, File] = {}
+
+    def add(file: File, language: Language | None) -> bool:
+        if file.dest_uri in chosen:
+            return False
+        if language is not None:  # Its path in the repository is its path in `docs_dir`.
+            file.edit_uri = f'{language.code}/{file.src_uri}'
+        chosen[file.dest_uri] = file
+        return True
+
+    def language_files(language: Language) -> list[File]:
+        path = os.path.join(docs_dir, language.code)
+        if not os.path.isdir(path):
+            return []
+        return walk_docs_dir(path, config)
+
+    for file in language_files(site.language):
+        add(file, site.language)
+
+    shared = walk_docs_dir(docs_dir, config, skip_dirs=site.languages.codes)
+    stray = [f for f in shared if f.is_documentation_page() and f.inclusion.is_included()]
+    if stray:
+        log.warning(
+            "The following pages are outside of the language directories "
+            f"({', '.join(d + '/' for d in site.languages.codes)}), so they are not part of the "
+            "site:\n  - " + "\n  - ".join(f.src_uri for f in stray)
+        )
+    for file in shared:
+        if not file.is_documentation_page():
+            add(file, None)
+
+    for language in site.languages:
+        if language == site.language:
+            continue
+        for file in language_files(language):
+            if add(file, language) and file.is_documentation_page():
+                site.untranslated[file.src_uri] = language
+
+    files = sorted(chosen.values(), key=file_sort_key)
+    if site.is_root:
+        _check_no_collision_with_language_sites(files, site)
+    return files
+
+
+def _check_no_collision_with_language_sites(files: list[File], site: LanguageSite) -> None:
+    codes = set(site.languages.codes)
+    clashes = [f for f in files if f.dest_uri.split('/', 1)[0] in codes]
+    if clashes:
+        raise BuildError(
+            "The following files would be written into the directory of a language's site when "
+            "the default language is built at the root of the site. Please rename or move them:"
+            "\n  - " + "\n  - ".join(f.edit_uri or f.src_uri for f in clashes)
+        )
+
+
+def localize_nav_titles(nav: Navigation, site: LanguageSite) -> None:
+    """
+    Show translated pages in the navigation under their own title.
+
+    Titles given in the `nav` config are written in the default language, so in the other
+    languages a translated page is listed under the title it declares itself (its `title`
+    metadata or its first heading), if any. Untranslated pages keep the `nav` title.
+
+    Must be called after the pages have been read.
+    """
+    if site.language.is_default:
+        return
+    for page in nav.pages:
+        if page.file.src_uri in site.untranslated or 'title' not in vars(page):
+            continue
+        if page.markdown is None:  # Not read, e.g. unmodified in a dirty build.
+            continue
+        own_title = page.meta.get('title') or page._title_from_render
+        if own_title:
+            page.title = own_title
+
+
+class AlternateLink(NamedTuple):
+    """A link to the page being rendered, in one of the site's languages."""
+
+    language: Language
+    url: str
+    """The URL of the page in that language, relative to the site's root: pass it through `|url`."""
+    canonical_url: str | None
+    """The full URL of the page in that language, if `site_url` is set."""
+    active: bool
+    """Whether this is the language of the page being rendered."""
+
+    @property
+    def code(self) -> str:
+        return self.language.code
+
+    @property
+    def name(self) -> str:
+        return self.language.name
+
+    @property
+    def hreflang(self) -> str:
+        return self.language.hreflang
+
+
+class LanguageContext:
+    """
+    What templates see as `language` on a multi-language site (on other sites it's undefined).
+
+    For example:
+
+        <html lang="{{ language.hreflang }}" dir="{{ language.dir }}">
+        {% for alt in language.alternates %}
+          <a href="{{ alt.url|url }}" hreflang="{{ alt.hreflang }}">{{ alt.name }}</a>
+        {% endfor %}
+    """
+
+    def __init__(
+        self, site: LanguageSite, page: Page | None, config: MkDocsConfig, base_url: str = ''
+    ) -> None:
+        self._site = site
+        source = site.untranslated.get(page.file.src_uri) if page is not None else None
+        self.untranslated = source is not None
+        self.content = source or site.language
+
+        if page is not None:
+            url = page.url
+        else:
+            url = '' if config.use_directory_urls else 'index.html'
+
+        def link_to(other: LanguageSite) -> AlternateLink:
+            link = site.url_to(other, url)
+            canonical_url = urljoin(config.site_url, link) if config.site_url else None
+            if page is None and base_url.startswith('/'):
+                # Error pages are served from any URL, so they use absolute URLs.
+                absolute = posixpath.normpath(posixpath.join(base_url, link))
+                link = absolute + ('/' if link.endswith('/') and absolute != '/' else '')
+            return AlternateLink(
+                language=other.language,
+                url=link,
+                canonical_url=canonical_url,
+                active=other.language == site.language,
+            )
+
+        self.alternates = [link_to(LanguageSite(site.languages, lang)) for lang in site.languages]
+        self.root = link_to(LanguageSite(site.languages, site.languages.default, is_root=True))
+
+    untranslated: bool
+    """Whether the page being rendered is not translated into this language, and is therefore
+    shown in another language (`content`)."""
+
+    content: Language
+    """The language that the content of the page being rendered is written in."""
+
+    alternates: list[AlternateLink]
+    """The page being rendered in each language of the site (the site's homepage, if rendering a
+    template that isn't a page), in the declared order, default language first."""
+
+    root: AlternateLink
+    """The page being rendered in the default language's copy at the root of the site: where
+    readers who haven't chosen a language land (`hreflang="x-default"`)."""
+
+    @property
+    def language(self) -> Language:
+        """The language of the site being rendered."""
+        return self._site.language
+
+    @property
+    def code(self) -> str:
+        return self.language.code
+
+    @property
+    def name(self) -> str:
+        return self.language.name
+
+    @property
+    def hreflang(self) -> str:
+        return self.language.hreflang
+
+    @property
+    def dir(self) -> str:
+        return self.language.dir
+
+    @property
+    def is_default(self) -> bool:
+        return self.language.is_default
+
+    @property
+    def languages(self) -> Languages:
+        return self._site.languages
+
+    def __str__(self) -> str:
+        return self.code
+
+
+# Themes can override this by providing an `untranslated.html` template.
+_DEFAULT_NOTICE_TEMPLATE = (
+    '<div class="mkdocs-untranslated-notice" role="note"><p>'
+    '{% trans %}This page has not been translated yet. It is shown in its original language.'
+    '{% endtrans %}</p></div>'
+)
+
+
+def mark_untranslated(
+    content: str, env: jinja2.Environment, context: TemplateContext, language: Language
+) -> str:
+    """
+    Return the content of an untranslated page with a notice saying so.
+
+    The notice is rendered, in the language of the site, from the theme's `untranslated.html`
+    template if it has one. The content is marked up as being in its own `language`.
+    """
+    try:
+        template = env.get_template('untranslated.html')
+    except jinja2.TemplateNotFound:
+        template = env.from_string(_DEFAULT_NOTICE_TEMPLATE)
+    notice = template.render(context)
+    return str(
+        Markup('{}<div class="mkdocs-untranslated" lang="{}" dir="{}">{}</div>').format(
+            Markup(notice), language.hreflang, language.dir, Markup(content)
+        )
+    )
+
+
+@contextmanager
+def logged_once_across_sites() -> Iterator[Callable[[], None]]:
+    """
+    Keep messages logged while building one language site from being repeated by the next ones.
+
+    The language sites largely consist of the same pages, so without this, a problem in a page of
+    the default language would be reported once for each site. Messages repeated while building
+    a single site are left alone, as they are in a single-language build.
+
+    Yields a function to call after building each site.
+    """
+    dedup = _SeenInPreviousSites()
+    handlers = []
+    logger: logging.Logger | None = logging.getLogger('mkdocs')
+    while logger is not None:
+        handlers.extend(logger.handlers)
+        logger = logger.parent if logger.propagate else None
+    for handler in handlers:
+        handler.addFilter(dedup)
+    try:
+        yield dedup.next_site
+    finally:
+        for handler in handlers:
+            handler.removeFilter(dedup)
+
+
+class _SeenInPreviousSites(logging.Filter):
+    def __init__(self) -> None:
+        super().__init__()
+        self.previous: set[tuple[int, str]] = set()
+        self.current: set[tuple[int, str]] = set()
+
+    def filter(self, record: logging.LogRecord) -> bool:
+        key = (record.levelno, record.getMessage())
+        if key in self.previous:
+            return False
+        self.current.add(key)
+        return True
+
+    def next_site(self) -> None:
+        self.previous |= self.current
+        self.current = set()
