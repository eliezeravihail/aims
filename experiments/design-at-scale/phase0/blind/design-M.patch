+        """Return a copy of the theme that can be modified without affecting this one."""
+        clone = copy.copy(self)
+        clone.dirs = list(self.dirs)
+        clone.static_templates = set(self.static_templates)
+        clone.__vars = {
+            k: copy.deepcopy(v) if isinstance(v, (dict, list, set)) else v
+            for k, v in self.__vars.items()
+        }
+        return clone
+
     def _load_theme_config(self, name: str) -> None:
         """Recursively load theme and any parent themes."""
         theme_dir = utils.get_theme_dir(name)
