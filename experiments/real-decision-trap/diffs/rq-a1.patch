+def _to_urllib3_timeout(timeout: _t.TimeoutType | TimeoutSauce) -> TimeoutSauce:
+    """Convert a Requests ``timeout`` value into the urllib3 ``Timeout`` to send with.
+
+    A single number (or None) applies to both connect and read; a
+    ``(connect, read)`` tuple sets them separately; a urllib3 ``Timeout`` is
+    used as given. Raises ValueError for anything else.
+    """
+    if isinstance(timeout, tuple):
+        try:
+            connect, read = timeout
+            return TimeoutSauce(connect=connect, read=read)
+        except ValueError:
+            raise ValueError(
+                f"Invalid timeout {timeout}. Pass a (connect, read) timeout tuple, "
+                f"or a single float to set both timeouts to the same value."
+            )
+    if isinstance(timeout, TimeoutSauce):
+        return timeout
+    return TimeoutSauce(connect=timeout, read=timeout)
+
