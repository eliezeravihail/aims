index 303e4cc..94621f2 100644
--- a/tests/test_adapters.py
+++ b/tests/test_adapters.py
@@ -6,3 +6,243 @@ def test_request_url_handles_leading_path_separators():
     a = requests.adapters.HTTPAdapter()
     p = requests.Request(method="GET", url="http://127.0.0.1:10000//v:h").prepare()
     assert "//v:h" == a.request_url(p, {})
+
+
+# --- Timeout handling in HTTPAdapter.send -----------------------------------
+#
+# These tests observe the urllib3 Timeout that HTTPAdapter.send hands to the
+# connection pool, without touching the network: the pool's urlopen records
+# the timeout and aborts the send.
+
+import pickle  # noqa: E402
+
+import pytest  # noqa: E402
+from urllib3.util import Timeout as Urllib3Timeout  # noqa: E402
+
+
+class _SendAborted(Exception):
+    """Raised by the fake pool once it has recorded the timeout."""
+
+
+class _RecordingPool:
+    def __init__(self):
+        self.timeouts = []
+
+    def urlopen(self, **kwargs):
+        self.timeouts.append(kwargs["timeout"])
+        raise _SendAborted()
+
+
+def _sent_timeout(adapter, monkeypatch, **send_kwargs):
+    """The urllib3 Timeout ``adapter.send`` would open the connection with."""
+    pool = _RecordingPool()
+    monkeypatch.setattr(
+        adapter, "get_connection_with_tls_context", lambda *a, **kw: pool
+    )
+    monkeypatch.setattr(adapter, "cert_verify", lambda *a, **kw: None)
+    prepared = requests.Request("GET", "http://example.invalid/").prepare()
+    with pytest.raises(_SendAborted):
+        adapter.send(prepared, **send_kwargs)
+    (timeout,) = pool.timeouts
+    return timeout
+
+
+def _as_pair(timeout):
+    return (timeout.connect_timeout, timeout.read_timeout)
+
+
+class TestPerCallTimeout:
+    """What a single send's own ``timeout`` means (no adapter default set)."""
+
+    def test_omitted_means_no_timeout(self, monkeypatch):
+        timeout = _sent_timeout(requests.adapters.HTTPAdapter(), monkeypatch)
+        assert _as_pair(timeout) == (None, None)
+
+    def test_none_means_no_timeout(self, monkeypatch):
+        timeout = _sent_timeout(
+            requests.adapters.HTTPAdapter(), monkeypatch, timeout=None
+        )
+        assert _as_pair(timeout) == (None, None)
+
+    def test_float_applies_to_connect_and_read(self, monkeypatch):
+        timeout = _sent_timeout(
+            requests.adapters.HTTPAdapter(), monkeypatch, timeout=2.5
+        )
+        assert _as_pair(timeout) == (2.5, 2.5)
+
+    def test_tuple_sets_connect_and_read_separately(self, monkeypatch):
+        timeout = _sent_timeout(
+            requests.adapters.HTTPAdapter(), monkeypatch, timeout=(3, None)
+        )
+        assert _as_pair(timeout) == (3, None)
+
+    def test_urllib3_timeout_is_used_as_given(self, monkeypatch):
+        given = Urllib3Timeout(connect=1, read=7)
+        timeout = _sent_timeout(
+            requests.adapters.HTTPAdapter(), monkeypatch, timeout=given
+        )
+        assert timeout is given
+
+    @pytest.mark.parametrize(
+        "timeout, error_text",
+        (
+            ((3, 4, 5), "Pass a (connect, read) timeout tuple"),
+            ((3,), "Pass a (connect, read) timeout tuple"),
+            ("foo", "must be an int, float or None"),
+        ),
+    )
+    def test_invalid_timeout_is_rejected(self, monkeypatch, timeout, error_text):
+        adapter = requests.adapters.HTTPAdapter()
+        monkeypatch.setattr(adapter, "cert_verify", lambda *a, **kw: None)
+        monkeypatch.setattr(
+            adapter,
+            "get_connection_with_tls_context",
+            lambda *a, **kw: _RecordingPool(),
+        )
+        prepared = requests.Request("GET", "http://example.invalid/").prepare()
+        with pytest.raises(ValueError, match=None) as e:
+            adapter.send(prepared, timeout=timeout)
+        assert error_text in str(e.value)
+
+
+class TestAdapterDefaultTimeout:
+    """An HTTPAdapter can hold a default timeout for every request it sends.
+
+    The default lives on the transport adapter, not on the Session: see
+    src/requests/sessions.py.md and src/requests/adapters.py.md.
+    """
+
+    def test_no_default_unless_set(self):
+        assert requests.adapters.HTTPAdapter().timeout is None
+
+    def test_default_applies_when_call_gives_none(self, monkeypatch):
+        adapter = requests.adapters.HTTPAdapter(timeout=5)
+        assert _as_pair(_sent_timeout(adapter, monkeypatch)) == (5, 5)
+        assert _as_pair(_sent_timeout(adapter, monkeypatch, timeout=None)) == (5, 5)
+
+    @pytest.mark.parametrize(
+        "default, expected",
+        (
+            (5, (5, 5)),
+            ((3.05, 27), (3.05, 27)),
+            ((None, 9), (None, 9)),
+            (Urllib3Timeout(connect=2, read=4), (2, 4)),
+        ),
+    )
+    def test_default_accepts_every_timeout_form(self, monkeypatch, default, expected):
+        adapter = requests.adapters.HTTPAdapter(timeout=default)
+        assert _as_pair(_sent_timeout(adapter, monkeypatch)) == expected
+
+    @pytest.mark.parametrize(
+        "own, expected",
+        (
+            (1.5, (1.5, 1.5)),
+            ((None, 5), (None, 5)),
+            ((None, None), (None, None)),
+            (Urllib3Timeout(connect=7, read=None), (7, None)),
+        ),
+    )
+    def test_call_timeout_replaces_default_entirely(self, monkeypatch, own, expected):
+        # The call's own timeout wins as a whole; its None components are not
+        # filled in from the default. (None, None) is how one call opts out.
+        adapter = requests.adapters.HTTPAdapter(timeout=(3, 10))
+        assert _as_pair(_sent_timeout(adapter, monkeypatch, timeout=own)) == expected
+
+    @pytest.mark.parametrize(
+        "default, error_text",
+        (
+            ((3, 4, 5), "Pass a (connect, read) timeout tuple"),
+            ("foo", "must be an int, float or None"),
+            (-1, "less than or equal to 0"),
+            ((1, -1), "Pass a (connect, read) timeout tuple"),
+        ),
+    )
+    def test_invalid_default_is_rejected_on_construction(self, default, error_text):
+        with pytest.raises(ValueError) as e:
+            requests.adapters.HTTPAdapter(timeout=default)
+        assert error_text in str(e.value)
+
+    def test_pickle_keeps_default(self, monkeypatch):
+        adapter = pickle.loads(
+            pickle.dumps(requests.adapters.HTTPAdapter(timeout=(2, 8)))
+        )
+        assert adapter.timeout == (2, 8)
+        assert _as_pair(_sent_timeout(adapter, monkeypatch)) == (2, 8)
+
+    def test_adapter_pickled_before_default_existed_has_none(self, monkeypatch):
+        state = requests.adapters.HTTPAdapter().__getstate__()
+        del state["timeout"]
+        adapter = requests.adapters.HTTPAdapter.__new__(requests.adapters.HTTPAdapter)
+        adapter.__setstate__(state)
+        assert adapter.timeout is None
+        assert _as_pair(_sent_timeout(adapter, monkeypatch)) == (None, None)
+
+    def test_pickled_session_keeps_mounted_default(self):
+        s = requests.Session()
+        s.mount("https://", requests.adapters.HTTPAdapter(timeout=4))
+        s = pickle.loads(pickle.dumps(s))
+        assert s.get_adapter("https://example.invalid/").timeout == 4
+
+
+def _mount_recording_default(session, default, monkeypatch):
+    adapter = requests.adapters.HTTPAdapter(timeout=default)
+    pool = _RecordingPool()
+    monkeypatch.setattr(
+        adapter, "get_connection_with_tls_context", lambda *a, **kw: pool
+    )
+    monkeypatch.setattr(adapter, "cert_verify", lambda *a, **kw: None)
+    session.mount("http://", adapter)
+    return pool
+
+
+class TestSessionUsesAdapterDefaultTimeout:
+    """Every request made through a Session reaches the mounted adapter's default."""
+
+    def test_session_request_without_timeout(self, monkeypatch):
+        s = requests.Session()
+        pool = _mount_recording_default(s, 6, monkeypatch)
+        with pytest.raises(_SendAborted):
+            s.get("http://example.invalid/")
+        assert [_as_pair(t) for t in pool.timeouts] == [(6, 6)]
+
+    def test_session_request_with_own_timeout(self, monkeypatch):
+        s = requests.Session()
+        pool = _mount_recording_default(s, 6, monkeypatch)
+        with pytest.raises(_SendAborted):
+            s.post("http://example.invalid/", data="x", timeout=(1, 2))
+        assert [_as_pair(t) for t in pool.timeouts] == [(1, 2)]
+
+    def test_session_send_of_prepared_request(self, monkeypatch):
+        s = requests.Session()
+        pool = _mount_recording_default(s, 6, monkeypatch)
+        prepared = s.prepare_request(requests.Request("GET", "http://example.invalid/"))
+        with pytest.raises(_SendAborted):
+            s.send(prepared)
+        assert [_as_pair(t) for t in pool.timeouts] == [(6, 6)]
+
+    def test_only_the_mounted_prefix_gets_the_default(self, monkeypatch):
+        s = requests.Session()
+        _mount_recording_default(s, 6, monkeypatch)
+        assert s.get_adapter("https://example.invalid/").timeout is None
+
+    def test_every_redirect_hop_gets_the_default(self, httpbin, monkeypatch):
+        import urllib3.connectionpool
+
+        seen = []
+        original = urllib3.connectionpool.HTTPConnectionPool.urlopen
+
+        def recording_urlopen(pool, method, url, *args, **kwargs):
+            seen.append((url, kwargs["timeout"]))
+            return original(pool, method, url, *args, **kwargs)
+
+        monkeypatch.setattr(
+            urllib3.connectionpool.HTTPConnectionPool, "urlopen", recording_urlopen
+        )
+        s = requests.Session()
+        s.mount("http://", requests.adapters.HTTPAdapter(timeout=(9, 11)))
+        r = s.get(httpbin("redirect/2"))
+
+        assert r.status_code == 200
+        assert len(r.history) == 2
+        assert len(seen) == 3
+        assert [_as_pair(t) for _, t in seen] == [(9, 11)] * 3
