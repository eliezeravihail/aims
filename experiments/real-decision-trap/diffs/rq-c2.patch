+class _RecordingAdapter(HTTPAdapter):
+    """Records the timeout each send() receives; optionally redirects once."""
+
+    def __init__(self, redirect_to=None):
+        super().__init__()
+        self.timeouts = []
+        self.redirect_to = redirect_to
+
+    def send(self, request, **kwargs):
+        self.timeouts.append(kwargs["timeout"])
+        resp = requests.Response()
+        resp.request = request
+        resp.url = request.url
+        resp.raw = io.BytesIO(b"")
+        if self.redirect_to and len(self.timeouts) == 1:
+            resp.status_code = 302
+            resp.headers["Location"] = self.redirect_to
+        else:
+            resp.status_code = 200
+        return resp
+
+
+class TestSessionTimeout:
+    """Session.timeout: a default applied when a request gives no timeout."""
+
+    def _session(self, **adapter_kwargs):
+        s = requests.Session()
+        adapter = _RecordingAdapter(**adapter_kwargs)
+        s.mount("http://", adapter)
+        return s, adapter
+
+    def test_defaults_to_none(self):
+        s, adapter = self._session()
+        assert s.timeout is None
+        s.get("http://example.test/")
+        assert adapter.timeouts == [None]
+
+    @pytest.mark.parametrize("default", (5, 2.5, (3.05, 27), (None, 10)))
+    def test_session_default_used_when_request_omits_timeout(self, default):
+        s, adapter = self._session()
+        s.timeout = default
+        s.get("http://example.test/")
+        s.post("http://example.test/", data="x")
+        s.request("DELETE", "http://example.test/")
+        assert adapter.timeouts == [default] * 3
+
+    def test_explicit_none_uses_session_default(self):
+        # None means "not specified", as for stream/verify/cert, so a wrapper
+        # that forwards timeout=None does not silently drop the default.
+        s, adapter = self._session()
+        s.timeout = 5
+        s.get("http://example.test/", timeout=None)
+        assert adapter.timeouts == [5]
+
+    @pytest.mark.parametrize(
+        "per_request",
+        (1, 0.5, (1, 2), (None, None), Urllib3Timeout(connect=1, read=2)),
+    )
+    def test_per_request_timeout_overrides_default(self, per_request):
+        s, adapter = self._session()
+        s.timeout = 5
+        s.get("http://example.test/", timeout=per_request)
+        assert adapter.timeouts == [per_request]
+
+    def test_override_does_not_persist(self):
+        s, adapter = self._session()
+        s.timeout = 5
+        s.get("http://example.test/", timeout=1)
+        s.get("http://example.test/")
+        assert adapter.timeouts == [1, 5]
+
+    def test_direct_send_uses_session_default(self):
+        s, adapter = self._session()
+        s.timeout = 5
+        prep = s.prepare_request(requests.Request("GET", "http://example.test/"))
+        s.send(prep)
+        s.send(prep, timeout=1)
+        assert adapter.timeouts == [5, 1]
+
+    @pytest.mark.parametrize("per_request, expected", ((None, 5), (1, 1)))
+    def test_redirects_use_the_same_timeout(self, per_request, expected):
+        s, adapter = self._session(redirect_to="http://example.test/next")
+        s.timeout = 5
+        r = s.get("http://example.test/", timeout=per_request)
+        assert len(r.history) == 1
+        assert adapter.timeouts == [expected, expected]
+
+    def test_response_hooks_see_resolved_timeout(self):
+        seen = []
+        s, _ = self._session()
+        s.timeout = 5
+        s.hooks["response"].append(lambda r, **kw: seen.append(kw["timeout"]))
+        s.get("http://example.test/")
+        assert seen == [5]
+
+    def test_timeout_survives_pickling(self):
+        s = requests.Session()
+        s.timeout = (3, 7)
+        assert pickle.loads(pickle.dumps(s)).timeout == (3, 7)
+
+    def test_unpickling_old_state_without_timeout(self):
+        s = requests.Session()
+        state = s.__getstate__()
+        del state["timeout"]
+        restored = requests.Session.__new__(requests.Session)
+        restored.__setstate__(state)
+        assert restored.timeout is None
+
+    def test_invalid_session_timeout_is_rejected(self, httpbin):
+        s = requests.Session()
+        s.timeout = (1, 2, 3)
+        with pytest.raises(ValueError, match=r"\(connect, read\)"):
+            s.get(httpbin("get"))
+
+    def test_session_default_times_out_real_request(self, httpbin):
+        s = requests.Session()
+        s.timeout = (None, 0.1)
+        with pytest.raises(ReadTimeout):
+            s.get(httpbin("delay/10"))
+
+    def test_per_request_none_tuple_waits_despite_default(self, httpbin):
+        s = requests.Session()
+        s.timeout = (None, 0.1)
+        r = s.get(httpbin("delay/1"), timeout=(None, None))
+        assert r.status_code == 200
+
+
