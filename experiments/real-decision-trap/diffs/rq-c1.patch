+class TimeoutRecordingAdapter(requests.adapters.BaseAdapter):
+    """Records the timeout each send receives; optionally redirects once."""
+
+    def __init__(self, redirect_first=False):
+        super().__init__()
+        self.timeouts = []
+        self.redirect_first = redirect_first
+
+    def send(self, request, timeout=None, **kwargs):
+        self.timeouts.append(timeout)
+        resp = requests.Response()
+        resp.request = request
+        resp.url = request.url
+        resp.raw = io.BytesIO(b"")
+        if self.redirect_first and len(self.timeouts) == 1:
+            resp.status_code = 302
+            resp.headers["Location"] = "/final"
+        else:
+            resp.status_code = 200
+        return resp
+
+    def close(self):
+        pass
+
+
+class TestSessionTimeout:
+    def _session(self, **adapter_kwargs):
+        s = requests.Session()
+        adapter = TimeoutRecordingAdapter(**adapter_kwargs)
+        s.mount("http://", adapter)
+        return s, adapter
+
+    def test_defaults_to_no_timeout(self):
+        s, adapter = self._session()
+        assert s.timeout is None
+        s.get("http://example.test/")
+        assert adapter.timeouts == [None]
+
+    @pytest.mark.parametrize(
+        "timeout", (5, 2.5, (3.05, 27), Urllib3Timeout(connect=1, read=2))
+    )
+    def test_session_timeout_used_when_call_omits_it(self, timeout):
+        s, adapter = self._session()
+        s.timeout = timeout
+        for method in ("get", "options", "head", "post", "put", "patch", "delete"):
+            getattr(s, method)("http://example.test/")
+        s.request("GET", "http://example.test/")
+        assert adapter.timeouts == [timeout] * 8
+
+    def test_call_timeout_overrides_session_timeout(self):
+        s, adapter = self._session()
+        s.timeout = 5
+        s.get("http://example.test/", timeout=1)
+        s.get("http://example.test/", timeout=(1, 2))
+        assert adapter.timeouts == [1, (1, 2)]
+
+    def test_call_timeout_none_uses_session_timeout(self):
+        # None means "not set on this call", as for stream/verify/cert.
+        s, adapter = self._session()
+        s.timeout = 5
+        s.get("http://example.test/", timeout=None)
+        assert adapter.timeouts == [5]
+
+    def test_call_can_opt_out_with_none_tuple(self):
+        s, adapter = self._session()
+        s.timeout = 5
+        s.get("http://example.test/", timeout=(None, None))
+        assert adapter.timeouts == [(None, None)]
+
+    def test_send_uses_session_timeout(self):
+        s, adapter = self._session()
+        s.timeout = 5
+        prep = s.prepare_request(requests.Request("GET", "http://example.test/"))
+        s.send(prep)
+        s.send(prep, timeout=1)
+        assert adapter.timeouts == [5, 1]
+
+    def test_redirects_use_session_timeout(self):
+        s, adapter = self._session(redirect_first=True)
+        s.timeout = 5
+        r = s.get("http://example.test/start")
+        assert r.url == "http://example.test/final"
+        assert adapter.timeouts == [5, 5]
+
+    def test_response_hooks_see_resolved_timeout(self):
+        s, _ = self._session()
+        s.timeout = 5
+        seen = []
+        s.hooks["response"].append(lambda r, **kw: seen.append(kw["timeout"]))
+        s.get("http://example.test/")
+        assert seen == [5]
+
+    def test_timeout_survives_pickling(self):
+        s = requests.Session()
+        s.timeout = (3, 7)
+        assert pickle.loads(pickle.dumps(s)).timeout == (3, 7)
+
+    def test_unpickling_state_without_timeout(self):
+        state = requests.Session().__getstate__()
+        del state["timeout"]
+        s = requests.Session.__new__(requests.Session)
+        s.__setstate__(state)
+        assert s.timeout is None
+
+    def test_session_timeout_raises_read_timeout(self, httpbin):
+        with requests.Session() as s:
+            s.timeout = (None, 0.1)
+            with pytest.raises(ReadTimeout):
+                s.get(httpbin("delay/10"))
+
+
