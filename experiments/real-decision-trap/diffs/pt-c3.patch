+class _RandomSamplerEpoch:
+    r"""Progress of one :class:`RandomSampler` iteration (one epoch).
+
+    ``generator_state`` is the state of the generator the epoch's order was drawn
+    from, taken just before the first draw; together with the sampler's
+    configuration it determines the epoch's whole order.
+
+    The count of yielded indices is derived rather than incremented per index, so the
+    iteration can ``yield from`` each drawn chunk at full speed: it is the number of
+    indices in the chunks already finished plus the position of the list iterator
+    over the current chunk (a list iterator reports exactly how many items it has
+    left).
+    """
+
+    __slots__ = (
+        "generator_state",
+        "_done",
+        "_chunk_len",
+        "_chunk_iter",
+        # Set on a position restored by ``load_state_dict``: the configuration it
+        # was saved under, re-checked when it is resumed.
+        "data_source_len",
+        "num_samples",
+    )
+
+    def __init__(self, generator_state: torch.Tensor, num_yielded: int = 0) -> None:
+        self.generator_state = generator_state
+        self._done = num_yielded
+        self._chunk_len = 0
+        self._chunk_iter: Iterator[int] = iter(())
+
+    def start_chunk(self, chunk_iter: Iterator[int], chunk_len: int) -> None:
+        # The iteration only moves on once the previous chunk is exhausted.
+        self._done += self._chunk_len
+        self._chunk_iter = chunk_iter
+        self._chunk_len = chunk_len
+
+    @property
+    def num_yielded(self) -> int:
+        return (
+            self._done
+            + self._chunk_len
+            - operator.length_hint(self._chunk_iter, self._chunk_len)
+        )
+
+
