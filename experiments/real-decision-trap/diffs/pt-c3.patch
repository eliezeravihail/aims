+    def test_random_sampler_state_dict_tracks_latest_iteration(self):
+        from torch.utils.data import RandomSampler
+
+        data = list(range(20))
+        sampler = RandomSampler(data)
+        old = iter(sampler)
+        next(old)
+        new = iter(sampler)
+        seen = [next(new) for _ in range(3)]
+        next(old)  # advancing a superseded iterator does not move the position
+        resumed = RandomSampler(data)
+        resumed.load_state_dict(sampler.state_dict())
+        self.assertEqual(sorted(seen + list(resumed)), data)
+
+    def test_random_sampler_state_dict_with_dataloader(self):
+        # DataLoader(shuffle=True, generator=g) shares g between the sampler and its
+        # worker base seed; resuming must not be thrown off by that extra draw.
+        data = list(range(50))
+
+        def make_loader(seed):
+            return DataLoader(
+                data,
+                batch_size=4,
+                shuffle=True,
+                generator=torch.Generator().manual_seed(seed),
+            )
+
+        full_epoch = [i for batch in make_loader(1) for i in batch.tolist()]
+        loader = make_loader(1)
+        it = iter(loader)
+        seen = [i for _ in range(5) for i in next(it).tolist()]
+        state = loader.sampler.state_dict()
+        self.assertEqual(state["num_yielded"], 20)
+
+        buffer = io.BytesIO()
+        torch.save(state, buffer)
+        buffer.seek(0)
+        resumed = make_loader(999)
+        resumed.sampler.load_state_dict(torch.load(buffer))
+        rest = [i for batch in resumed for i in batch.tolist()]
+        self.assertEqual(seen + rest, full_epoch)
+
+    def test_random_sampler_load_state_dict_validation(self):
+        from torch.utils.data import RandomSampler
+
+        data = list(range(10))
+        sampler = RandomSampler(data)
+        it = iter(sampler)
+        next(it)
+        state = sampler.state_dict()
+
+        with self.assertRaisesRegex(ValueError, "data_source_len=10"):
+            RandomSampler(list(range(11))).load_state_dict(state)
+        with self.assertRaisesRegex(ValueError, "num_samples=10"):
+            RandomSampler(data, num_samples=5).load_state_dict(state)
+        with self.assertRaisesRegex(ValueError, "replacement=False"):
+            RandomSampler(data, replacement=True).load_state_dict(state)
+        with self.assertRaisesRegex(ValueError, "missing keys"):
+            RandomSampler(data).load_state_dict({"num_yielded": 1})
+        with self.assertRaisesRegex(ValueError, "num_yielded"):
+            RandomSampler(data).load_state_dict({**state, "num_yielded": 11})
+
+        # The data changing size between loading and resuming is caught too.
+        growing = list(range(10))
+        resumed = RandomSampler(growing)
+        resumed.load_state_dict(state)
+        growing.append(10)
+        with self.assertRaisesRegex(ValueError, "data_source_len=10"):
+            next(iter(resumed))
