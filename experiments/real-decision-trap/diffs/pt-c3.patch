+    def test_random_sampler_state_dict_between_epochs(self):
+        from torch.utils.data import RandomSampler
+
+        data = list(range(10))
+        sampler = RandomSampler(data)
+        self.assertIsNone(sampler.state_dict()["generator_state"])
+        list(sampler)
+        state = sampler.state_dict()
+        self.assertIsNone(state["generator_state"])
+        self.assertEqual(state["num_yielded"], 0)
+
+        # Loading "no epoch in progress" discards a pending position.
+        it = iter(sampler)
+        next(it)
+        mid_epoch = sampler.state_dict()
+        resumed = RandomSampler(data)
+        resumed.load_state_dict(mid_epoch)
+        resumed.load_state_dict(state)
+        self.assertEqual(sorted(resumed), data)
+
+        # An epoch whose indices were all yielded, but which had not finished,
+        # resumes as an empty epoch; the next one is a full epoch.
+        it = iter(sampler)
+        list(itertools.islice(it, len(data)))
+        resumed = RandomSampler(data)
+        resumed.load_state_dict(sampler.state_dict())
+        self.assertEqual(list(resumed), [])
+        self.assertEqual(sorted(resumed), data)
