+        >>> sampler = RandomSampler(dataset)
+        >>> sampler.load_state_dict(state)
+        >>> rest = list(sampler)  # exactly the indices ``it`` had not yielded yet
+        >>> sorted(seen + rest) == list(range(len(dataset)))
+        True
