+    def state_dict(self) -> dict[str, Any]:
+        r"""Return the sampler's position within the current epoch, as a picklable dict.
+
+        Passing it to :meth:`load_state_dict` of a new :class:`RandomSampler` over the
+        same data (same length, ``replacement`` and ``num_samples``) makes that
+        sampler's next iteration yield exactly the indices the current iteration has
+        not yielded yet, in the same order; later epochs are shuffled as usual.
+
+        The position is that of the most recently started iteration; an iteration
+        starts when its first index is requested. If no epoch is in progress (the
+        sampler was never iterated, or its last iteration ran to completion), the
+        state says so, and loading it leaves the next epoch to be shuffled as usual.
+        A state loaded with :meth:`load_state_dict` and not yet resumed is returned
+        as loaded.
+
+        .. note::
+            The position counts the indices the *sampler* has yielded. Used through a
+            :class:`~torch.utils.data.DataLoader` with ``num_workers=0``, that is
+            exactly the samples returned to the training loop. With
+            ``num_workers > 0``, the loader draws indices ahead of the training loop
+            to prefetch batches (up to ``prefetch_factor * num_workers`` batches), so
+            the saved position is ahead of what the model has seen by those batches,
+            and a job resumed from it will not see them.
+
+        The returned dict has the keys:
+
+        * ``"num_samples"``, ``"data_source_len"``, ``"replacement"``: the
+          configuration the position refers to; :meth:`load_state_dict` checks them.
+        * ``"generator_state"``: the state of the generator the epoch's order was
+          drawn from, taken before its first draw (a ``torch.ByteTensor``), or
+          ``None`` if no epoch is in progress.
+        * ``"num_yielded"``: how many indices of the epoch have been yielded.
+        """
+        epoch = self._resume if self._resume is not None else self._epoch
+        return {
+            "num_samples": self.num_samples,
+            "data_source_len": len(self.data_source),
+            "replacement": self.replacement,
+            "generator_state": None
+            if epoch is None
+            else epoch.generator_state.clone(),
+            "num_yielded": 0 if epoch is None else epoch.num_yielded,
+        }
+
+    def load_state_dict(self, state_dict: dict[str, Any]) -> None:
+        r"""Restore a position saved by :meth:`state_dict`.
+
+        The sampler's next iteration yields the indices the saved iteration had not
+        yielded yet, in the same order; iterations after that are shuffled as usual.
+        With a ``generator``, that iteration sets the generator to its saved state
+        before drawing, and leaves it where the uninterrupted iteration would have.
+        Without one, it does not draw a seed from the global RNG.
+
+        Loading a state saved when no epoch was in progress discards any pending
+        position, so the next iteration is freshly shuffled.
+
+        Raises:
+            ValueError: if the state was saved by a sampler with a different
+                ``replacement``, ``num_samples`` or data length, or is malformed.
+        """
+        missing = {
+            "num_samples",
+            "data_source_len",
+            "replacement",
+            "generator_state",
+            "num_yielded",
+        } - state_dict.keys()
+        if missing:
+            raise ValueError(
+                f"RandomSampler state_dict is missing keys: {sorted(missing)}"
+            )
+        if state_dict["replacement"] != self.replacement:
+            raise ValueError(
+                f"RandomSampler state_dict was saved with replacement="
+                f"{state_dict['replacement']!r}, but this sampler has "
+                f"replacement={self.replacement!r}"
+            )
+        self._check_resumable(
+            len(self.data_source),
+            state_dict["data_source_len"],
+            state_dict["num_samples"],
+        )
+
+        generator_state = state_dict["generator_state"]
+        num_yielded = state_dict["num_yielded"]
+        if generator_state is None:
+            self._resume = None
+            return
+        if not isinstance(generator_state, torch.Tensor):
+            raise ValueError(
+                "RandomSampler state_dict 'generator_state' should be a tensor or None, "
+                f"but got {type(generator_state).__name__}"
+            )
+        if (
+            not isinstance(num_yielded, int)
+            or isinstance(num_yielded, bool)
+            or not 0 <= num_yielded <= self.num_samples
+        ):
+            raise ValueError(
+                "RandomSampler state_dict 'num_yielded' should be an integer between 0 "
+                f"and num_samples={self.num_samples}, but got {num_yielded!r}"
+            )
+        resume = _RandomSamplerEpoch(generator_state.clone(), num_yielded)
+        resume.data_source_len = state_dict["data_source_len"]
+        resume.num_samples = state_dict["num_samples"]
+        self._resume = resume
+
+    def _check_resumable(
+        self, n: int, saved_data_source_len: int, saved_num_samples: int
+    ) -> None:
+        mismatched = [
+            f"{name}={saved!r} (this sampler has {current!r})"
+            for name, saved, current in (
+                ("data_source_len", saved_data_source_len, n),
+                ("num_samples", saved_num_samples, self.num_samples),
+            )
+            if saved != current
+        ]
+        if mismatched:
+            raise ValueError(
+                "RandomSampler state_dict was saved by a sampler over different data "
+                "or with a different num_samples: " + ", ".join(mismatched)
+            )
+
 
 class SubsetRandomSampler(Sampler[int]):
     r"""Samples elements randomly from a given list of indices, without replacement.
