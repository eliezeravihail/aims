+    def _random_sampler_interrupt(self, make_sampler, k):
+        # Iterate a fresh sampler for k indices, then checkpoint it the way a job
+        # would: pickle the state dict.
+        sampler = make_sampler()
+        it = iter(sampler)
+        seen = list(itertools.islice(it, k))
+        return seen, pickle.loads(pickle.dumps(sampler.state_dict()))
+
+    def test_random_sampler_state_dict_resume(self):
+        from torch.utils.data import RandomSampler
+
+        data = list(range(50))
+        for replacement, num_samples, use_generator in itertools.product(
+            (False, True), (None, 20, 32, 33, 50, 64, 120), (False, True)
+        ):
+            total = num_samples or len(data)
+            for k in sorted({1, 2, 31, 32, 33, 50, total - 1, total}):
+                if not 1 <= k <= total:
+                    continue
+                with self.subTest(
+                    replacement=replacement,
+                    num_samples=num_samples,
+                    generator=use_generator,
+                    k=k,
+                ):
+
+                    def make_sampler(seed=7):
+                        generator = (
+                            torch.Generator().manual_seed(seed)
+                            if use_generator
+                            else None
+                        )
+                        return RandomSampler(
+                            data,
+                            replacement=replacement,
+                            num_samples=num_samples,
+                            generator=generator,
+                        )
+
+                    torch.manual_seed(0)
+                    reference = make_sampler()
+                    full_epoch = list(reference)
+                    next_epoch = list(reference)
+
+                    torch.manual_seed(0)
+                    seen, state = self._random_sampler_interrupt(make_sampler, k)
+                    self.assertEqual(state["num_yielded"], k)
+
+                    # The resumed job's generator starts elsewhere; the state decides.
+                    resumed = make_sampler(seed=12345)
+                    resumed.load_state_dict(state)
+                    global_rng = torch.get_rng_state()
+                    rest = list(resumed)
+                    self.assertEqual(seen + rest, full_epoch)
+                    self.assertEqual(len(rest), total - k)
+                    if use_generator:
+                        # The generator ends the epoch where it would have, so
+                        # the following epoch matches the uninterrupted run.
+                        self.assertEqual(list(resumed), next_epoch)
+                    else:
+                        # The resumed epoch draws no seed from the global RNG ...
+                        self.assertEqual(torch.get_rng_state(), global_rng)
+                        # ... and the following epoch draws one as usual.
+                        torch.set_rng_state(global_rng)
+                        self.assertEqual(list(resumed), next_epoch)
+
