+class TimeoutRecordingAdapter(requests.adapters.BaseAdapter):
+    """Records the timeout each request reaches the adapter with.
+
+    Answers the first ``redirects`` requests with a redirect, then 200.
+    """
+
+    def __init__(self, redirects=0):
+        super().__init__()
+        self.timeouts = []
+        self.redirects = redirects
+
+    def send(self, request, **kwargs):
+        self.timeouts.append(kwargs["timeout"])
+        resp = requests.Response()
+        resp.request = request
+        resp.url = request.url
+        resp.raw = io.BytesIO(b"")
+        resp._content = b""
+        resp._content_consumed = True
+        if len(self.timeouts) <= self.redirects:
+            resp.status_code = 302
+            resp.headers["Location"] = "/next"
+        else:
+            resp.status_code = 200
+        return resp
+
+    def close(self):
+        pass
+
+
+class TestSessionTimeout:
+    @staticmethod
+    def session_with_adapter(timeout, redirects=0):
+        s = requests.Session()
+        s.timeout = timeout
+        adapter = TimeoutRecordingAdapter(redirects=redirects)
+        s.mount("http://", adapter)
+        return s, adapter
+
+    def test_default_is_no_timeout(self):
+        s, adapter = self.session_with_adapter(timeout=None)
+        assert requests.Session().timeout is None
+        s.get("http://example.test/")
+        assert adapter.timeouts == [None]
+
+    @pytest.mark.parametrize(
+        "timeout", (5, 2.5, (3.05, 27), (None, 10), Urllib3Timeout(connect=1, read=2))
+    )
+    def test_session_timeout_used_when_call_omits_it(self, timeout):
+        s, adapter = self.session_with_adapter(timeout)
+        s.get("http://example.test/")
+        s.post("http://example.test/", data="x")
+        s.request("DELETE", "http://example.test/")
+        assert adapter.timeouts == [timeout] * 3
+
+    def test_explicit_none_uses_session_timeout(self):
+        # None means "not specified", as for the other session settings, so a
+        # wrapper that passes its own ``timeout=None`` through keeps the default.
+        s, adapter = self.session_with_adapter(5)
+        s.get("http://example.test/", timeout=None)
+        assert adapter.timeouts == [5]
+
+    @pytest.mark.parametrize(
+        "call_timeout", (1, 0.5, (2, 3), (None, None), Urllib3Timeout(read=None))
+    )
+    def test_call_timeout_overrides_session_timeout(self, call_timeout):
+        s, adapter = self.session_with_adapter(5)
+        s.get("http://example.test/", timeout=call_timeout)
+        assert adapter.timeouts == [call_timeout]
+
+    def test_call_timeout_is_not_persisted(self):
+        s, adapter = self.session_with_adapter(5)
+        s.get("http://example.test/", timeout=1)
+        s.get("http://example.test/")
+        assert adapter.timeouts == [1, 5]
+        assert s.timeout == 5
+
+    def test_session_timeout_applies_to_send(self):
+        s, adapter = self.session_with_adapter(5)
+        prep = s.prepare_request(requests.Request("GET", "http://example.test/"))
+        s.send(prep)
+        s.send(prep, timeout=None)
+        s.send(prep, timeout=1)
+        assert adapter.timeouts == [5, 5, 1]
+
+    @pytest.mark.parametrize("call_timeout, expected", ((None, 5), (1, 1)))
+    def test_timeout_applies_to_redirects(self, call_timeout, expected):
+        s, adapter = self.session_with_adapter(5, redirects=2)
+        r = s.get("http://example.test/", timeout=call_timeout)
+        assert len(r.history) == 2
+        assert adapter.timeouts == [expected] * 3
+
+    def test_response_hook_sees_resolved_timeout(self):
+        seen = []
+        s, adapter = self.session_with_adapter(5)
+        s.hooks["response"].append(lambda r, **kw: seen.append(kw["timeout"]))
+        s.get("http://example.test/")
+        assert seen == [5]
+
+    def test_timeout_survives_pickling(self):
+        s = requests.Session()
+        s.timeout = (3.05, 27)
+        assert pickle.loads(pickle.dumps(s)).timeout == (3.05, 27)
+
+    def test_unpickling_session_without_timeout(self):
+        # A Session pickled before the attribute existed.
+        state = requests.Session().__getstate__()
+        del state["timeout"]
+        s = requests.Session.__new__(requests.Session)
+        s.__setstate__(state)
+        assert s.timeout is None
+
+    def test_session_timeout_raises_read_timeout(self, httpbin):
+        with requests.Session() as s:
+            s.timeout = (None, 0.1)
+            with pytest.raises(ReadTimeout):
+                s.get(httpbin("delay/1"))
+
+    def test_call_timeout_overrides_session_timeout_on_the_wire(self, httpbin):
+        with requests.Session() as s:
+            s.timeout = (None, 0.1)
+            r = s.get(httpbin("delay/1"), timeout=10)
+            assert r.status_code == 200
+
+    def test_invalid_session_timeout(self, httpbin):
+        with requests.Session() as s:
+            s.timeout = (3, 4, 5)
+            with pytest.raises(ValueError, match=r"\(connect, read\)"):
+                s.get(httpbin("get"))
+
+
