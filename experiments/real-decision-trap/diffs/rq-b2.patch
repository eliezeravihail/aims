+"""Tests for Session.timeout — the session-level default timeout.
+
+A recording adapter stands in for the network so each test can assert the
+exact timeout value that reaches the transport layer for every request the
+session sends (including each redirect hop).
+"""
+
+import io
+import pickle
+
+import pytest
+
+import requests
+from requests.adapters import BaseAdapter
+from requests.models import Response
+
+
+class RecordingAdapter(BaseAdapter):
+    """Adapter that records the timeout of every send and replies from a script.
+
+    ``redirects`` is a list of Location targets returned (as 302s) before the
+    final 200 response.
+    """
+
+    def __init__(self, redirects=()):
+        super().__init__()
+        self.redirects = list(redirects)
+        self.timeouts = []
+
+    def send(self, request, stream=False, timeout=None, verify=True, cert=None, proxies=None):
+        self.timeouts.append(timeout)
+        resp = Response()
+        resp.request = request
+        resp.url = request.url
+        resp.raw = io.BytesIO(b"")
+        if self.redirects:
+            resp.status_code = 302
+            resp.headers["Location"] = self.redirects.pop(0)
+        else:
+            resp.status_code = 200
+        return resp
+
+    def close(self):
+        pass
+
+
+def make_session(redirects=()):
+    session = requests.Session()
+    adapter = RecordingAdapter(redirects)
+    session.mount("http://", adapter)
+    return session, adapter
+
+
+URL = "http://example.test/"
+
+
+class TestWithoutSessionDefault:
+    """Characterization: a session with no default behaves exactly as before."""
+
+    def test_default_is_unset(self):
+        assert requests.Session().timeout is None
+
+    def test_no_timeout_reaches_adapter_as_none(self):
+        session, adapter = make_session()
+        session.get(URL)
+        assert adapter.timeouts == [None]
+
+    @pytest.mark.parametrize("timeout", [5, 2.5, (1, 2), (None, 3), None])
+    def test_per_call_timeout_passes_through_unchanged(self, timeout):
+        session, adapter = make_session()
+        session.get(URL, timeout=timeout)
+        assert adapter.timeouts == [timeout]
+
+    def test_send_without_timeout_reaches_adapter_as_none(self):
+        session, adapter = make_session()
+        session.send(requests.Request("GET", URL).prepare())
+        assert adapter.timeouts == [None]
+
+    def test_redirect_hops_carry_per_call_timeout(self):
+        session, adapter = make_session(redirects=["/a", "/b"])
+        session.get(URL, timeout=4)
+        assert adapter.timeouts == [4, 4, 4]
+
+
+class TestWithSessionDefault:
+    def test_default_used_when_call_omits_timeout(self):
+        session, adapter = make_session()
+        session.timeout = 10
+        session.get(URL)
+        assert adapter.timeouts == [10]
+
+    @pytest.mark.parametrize("method", ["get", "options", "head", "post", "put", "patch", "delete"])
+    def test_default_used_by_every_verb_helper(self, method):
+        session, adapter = make_session()
+        session.timeout = 10
+        getattr(session, method)(URL)
+        assert adapter.timeouts == [10]
+
+    def test_default_used_by_request(self):
+        session, adapter = make_session()
+        session.timeout = (3, 30)
+        session.request("GET", URL)
+        assert adapter.timeouts == [(3, 30)]
+
+    @pytest.mark.parametrize("timeout", [5, 2.5, 0, (1, 2), (None, 3)])
+    def test_per_call_timeout_overrides_default(self, timeout):
+        session, adapter = make_session()
+        session.timeout = 10
+        session.get(URL, timeout=timeout)
+        assert adapter.timeouts == [timeout]
+
+    def test_per_call_urllib3_timeout_overrides_default(self):
+        from urllib3.util import Timeout
+
+        explicit = Timeout(connect=1, read=2)
+        session, adapter = make_session()
+        session.timeout = 10
+        session.get(URL, timeout=explicit)
+        assert adapter.timeouts == [explicit]
+
+    def test_explicit_none_uses_default(self):
+        # A helper that forwards its own ``timeout=None`` must not bypass
+        # the session default; that is the hang the default exists to stop.
+        session, adapter = make_session()
+        session.timeout = 10
+
+        def fetch(url, timeout=None):
+            return session.get(url, timeout=timeout)
+
+        fetch(URL)
+        assert adapter.timeouts == [10]
+
+    def test_none_none_tuple_opts_out_of_default(self):
+        session, adapter = make_session()
+        session.timeout = 10
+        session.get(URL, timeout=(None, None))
+        assert adapter.timeouts == [(None, None)]
+
+    def test_send_without_timeout_uses_default(self):
+        session, adapter = make_session()
+        session.timeout = 10
+        session.send(requests.Request("GET", URL).prepare())
+        assert adapter.timeouts == [10]
+
+    def test_send_with_explicit_none_uses_default(self):
+        session, adapter = make_session()
+        session.timeout = 10
+        session.send(requests.Request("GET", URL).prepare(), timeout=None)
+        assert adapter.timeouts == [10]
+
+    def test_send_with_explicit_timeout_overrides_default(self):
+        session, adapter = make_session()
+        session.timeout = 10
+        session.send(requests.Request("GET", URL).prepare(), timeout=2)
+        assert adapter.timeouts == [2]
+
+    def test_every_redirect_hop_uses_default(self):
+        session, adapter = make_session(redirects=["/a", "/b"])
+        session.timeout = 10
+        session.get(URL)
+        assert adapter.timeouts == [10, 10, 10]
+
+    def test_every_redirect_hop_uses_per_call_override(self):
+        session, adapter = make_session(redirects=["/a", "/b"])
+        session.timeout = 10
+        session.get(URL, timeout=4)
+        assert adapter.timeouts == [4, 4, 4]
+
+    def test_next_redirect_request_is_sent_with_default(self):
+        # With allow_redirects=False the pending hop is exposed as
+        # ``response.next``; following it via send() still gets the default.
+        session, adapter = make_session(redirects=["/a"])
+        session.timeout = 10
+        resp = session.get(URL, allow_redirects=False)
+        session.send(resp.next)
+        assert adapter.timeouts == [10, 10]
+
+    def test_response_hooks_see_effective_timeout(self):
+        seen = []
+
+        def hook(response, **kwargs):
+            seen.append(kwargs["timeout"])
+
+        session, adapter = make_session()
+        session.timeout = 10
+        session.get(URL, hooks={"response": hook})
+        assert seen == [10]
+
+    def test_changing_default_affects_next_request(self):
+        session, adapter = make_session()
+        session.timeout = 10
+        session.get(URL)
+        session.timeout = 20
+        session.get(URL)
+        session.timeout = None
+        session.get(URL)
+        assert adapter.timeouts == [10, 20, None]
+
+    def test_default_does_not_leak_to_module_level_api(self, monkeypatch):
+        # Module-level helpers build a fresh Session each call; a default set
+        # on some other session must not affect them.
+        other = requests.Session()
+        other.timeout = 10
+        recorded = []
+
+        def fake_send(self, request, **kwargs):
+            recorded.append(kwargs.get("timeout"))
+            raise RuntimeError("stop")
+
+        monkeypatch.setattr(requests.Session, "send", fake_send)
+        with pytest.raises(RuntimeError):
+            requests.get(URL)
+        assert recorded == [None]
+
+
+class TestSessionDefaultPickling:
+    def test_pickle_round_trip_keeps_default(self):
+        session = requests.Session()
+        session.timeout = (3, 30)
+        restored = pickle.loads(pickle.dumps(session))
+        assert restored.timeout == (3, 30)
+
+    def test_unpickling_state_without_timeout_has_no_default(self):
+        # State produced before Session.timeout existed has no "timeout" key.
+        state = requests.Session().__getstate__()
+        del state["timeout"]
+        restored = requests.Session.__new__(requests.Session)
+        restored.__setstate__(state)
+        adapter = RecordingAdapter()
+        restored.mount("http://", adapter)
+        restored.get(URL)
+        assert restored.timeout is None
+        assert adapter.timeouts == [None]
+
+
+class TestMalformedSessionDefault:
+    def test_malformed_default_fails_like_malformed_per_call_timeout(self):
+        per_call = requests.Session()
+        with pytest.raises(ValueError) as per_call_err:
+            per_call.get("http://127.0.0.1:1/", timeout=(1, 2, 3))
+
+        session = requests.Session()
+        session.timeout = (1, 2, 3)
+        with pytest.raises(ValueError) as default_err:
+            session.get("http://127.0.0.1:1/")
+
+        assert str(default_err.value) == str(per_call_err.value)
