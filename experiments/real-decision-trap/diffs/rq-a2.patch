index 303e4cc..5bd6e03 100644
--- a/tests/test_adapters.py
+++ b/tests/test_adapters.py
@@ -6,3 +6,221 @@ def test_request_url_handles_leading_path_separators():
     a = requests.adapters.HTTPAdapter()
     p = requests.Request(method="GET", url="http://127.0.0.1:10000//v:h").prepare()
     assert "//v:h" == a.request_url(p, {})
+
+
+# --- Default timeout owned by the transport adapter -------------------------
+#
+# A Session holds no timeout (see src/requests/sessions.py.md). A default is set
+# on the HTTPAdapter a Session mounts; the adapter applies it to every send that
+# does not carry its own timeout.
+
+import pickle
+
+import pytest
+from urllib3.connectionpool import HTTPConnectionPool
+from urllib3.util import Timeout as Urllib3Timeout
+
+import requests
+from requests.adapters import HTTPAdapter
+from requests.exceptions import ReadTimeout
+
+
+class _Sent(Exception):
+    """Raised by the fake connection so a send stops once urllib3 is reached."""
+
+
+class _RecordingConn:
+    def __init__(self):
+        self.timeout = "never called"
+
+    def urlopen(self, **kwargs):
+        self.timeout = kwargs["timeout"]
+        raise _Sent()
+
+
+def _timeout_reaching_urllib3(adapter, **send_kwargs):
+    conn = _RecordingConn()
+    adapter.get_connection_with_tls_context = lambda *a, **kw: conn
+    adapter.cert_verify = lambda *a, **kw: None
+    request = requests.Request("GET", "http://example.invalid/").prepare()
+    with pytest.raises(_Sent):
+        adapter.send(request, **send_kwargs)
+    return conn.timeout
+
+
+def _as_pair(timeout):
+    return (timeout.connect_timeout, timeout.read_timeout)
+
+
+@pytest.fixture
+def urlopen_timeouts(monkeypatch):
+    """Record the timeout of every real urllib3 urlopen call."""
+    seen = []
+    real_urlopen = HTTPConnectionPool.urlopen
+
+    def recording_urlopen(self, method, url, *args, **kwargs):
+        seen.append(kwargs.get("timeout"))
+        return real_urlopen(self, method, url, *args, **kwargs)
+
+    monkeypatch.setattr(HTTPConnectionPool, "urlopen", recording_urlopen)
+    return seen
+
+
+class TestAdapterDefaultTimeout:
+    def test_without_a_default_an_omitted_timeout_means_no_timeout(self):
+        timeout = _timeout_reaching_urllib3(HTTPAdapter())
+        assert _as_pair(timeout) == (None, None)
+
+    @pytest.mark.parametrize(
+        "default, expected",
+        (
+            (5, (5, 5)),
+            (2.5, (2.5, 2.5)),
+            ((3, 7), (3, 7)),
+            ((None, 7), (None, 7)),
+            (Urllib3Timeout(connect=1, read=9), (1, 9)),
+        ),
+    )
+    def test_the_default_applies_when_the_call_gives_no_timeout(
+        self, default, expected
+    ):
+        adapter = HTTPAdapter(timeout=default)
+        assert _as_pair(_timeout_reaching_urllib3(adapter)) == expected
+
+    def test_an_explicit_none_is_the_same_as_omitting_the_timeout(self):
+        adapter = HTTPAdapter(timeout=5)
+        timeout = _timeout_reaching_urllib3(adapter, timeout=None)
+        assert _as_pair(timeout) == (5, 5)
+
+    @pytest.mark.parametrize(
+        "call_timeout, expected",
+        (
+            (1, (1, 1)),
+            ((2, 3), (2, 3)),
+            # The call's tuple wins wholly: its None is not filled from the default.
+            ((None, 3), (None, 3)),
+            (Urllib3Timeout(connect=4, read=None), (4, None)),
+        ),
+    )
+    def test_a_call_timeout_wins_over_the_default(self, call_timeout, expected):
+        adapter = HTTPAdapter(timeout=(10, 20))
+        timeout = _timeout_reaching_urllib3(adapter, timeout=call_timeout)
+        assert _as_pair(timeout) == expected
+
+    @pytest.mark.parametrize(
+        "wait_forever", ((None, None), Urllib3Timeout(connect=None, read=None))
+    )
+    def test_a_call_can_still_wait_forever_despite_a_default(self, wait_forever):
+        adapter = HTTPAdapter(timeout=5)
+        timeout = _timeout_reaching_urllib3(adapter, timeout=wait_forever)
+        assert _as_pair(timeout) == (None, None)
+
+    @pytest.mark.parametrize(
+        "bad, error_text",
+        (
+            ((3, 4, 5), "(connect, read)"),
+            ("foo", "must be an int, float or None"),
+            (-1, "less than or equal to 0"),
+            (0, "less than or equal to 0"),
+        ),
+    )
+    def test_an_invalid_default_is_rejected_at_construction(self, bad, error_text):
+        with pytest.raises(ValueError) as e:
+            HTTPAdapter(timeout=bad)
+        assert error_text in str(e.value)
+
+    def test_a_default_does_not_hide_an_invalid_call_timeout(self):
+        adapter = HTTPAdapter(timeout=5)
+        with pytest.raises(ValueError, match=r"\(connect, read\)"):
+            _timeout_reaching_urllib3(adapter, timeout=(1, 2, 3))
+
+    def test_add_headers_sees_the_effective_timeout(self):
+        seen = []
+
+        class Recording(HTTPAdapter):
+            def add_headers(self, request, **kwargs):
+                seen.append(kwargs["timeout"])
+
+        adapter = Recording(timeout=(3, 7))
+        _timeout_reaching_urllib3(adapter)
+        _timeout_reaching_urllib3(adapter, timeout=1)
+        assert seen == [(3, 7), 1]
+
+    def test_the_default_survives_pickling(self):
+        adapter = pickle.loads(pickle.dumps(HTTPAdapter(timeout=(3, 7))))
+        assert _as_pair(_timeout_reaching_urllib3(adapter)) == (3, 7)
+
+    def test_state_pickled_without_a_default_restores_as_no_default(self):
+        state = HTTPAdapter().__getstate__()
+        del state["timeout"]  # as pickled by a version without this feature
+        adapter = HTTPAdapter.__new__(HTTPAdapter)
+        adapter.__setstate__(state)
+        assert _as_pair(_timeout_reaching_urllib3(adapter)) == (None, None)
+
+    def test_a_subclass_that_skips_the_base_init_has_no_default(self):
+        class OwnInit(HTTPAdapter):
+            def __init__(self):
+                self.max_retries = requests.adapters.Retry(0, read=False)
+                self.config = {}
+                self.proxy_manager = {}
+                self.init_poolmanager(1, 1)
+
+        assert _as_pair(_timeout_reaching_urllib3(OwnInit())) == (None, None)
+
+
+class TestSessionUsesMountedAdapterDefault:
+    def _session(self, default):
+        s = requests.Session()
+        adapter = HTTPAdapter(timeout=default)
+        s.mount("http://", adapter)
+        s.mount("https://", adapter)
+        return s
+
+    def test_session_has_no_timeout_state(self):
+        s = requests.Session()
+        assert not hasattr(s, "timeout")
+        assert "timeout" not in s.__attrs__
+
+    def test_every_request_through_the_session_uses_the_default(
+        self, httpbin, urlopen_timeouts
+    ):
+        s = self._session((3, 7))
+        s.get(httpbin("get"))
+        s.post(httpbin("post"), data="x")
+        assert [_as_pair(t) for t in urlopen_timeouts] == [(3, 7), (3, 7)]
+
+    def test_a_call_timeout_overrides_the_default(self, httpbin, urlopen_timeouts):
+        s = self._session((3, 7))
+        s.get(httpbin("get"), timeout=1)
+        assert [_as_pair(t) for t in urlopen_timeouts] == [(1, 1)]
+
+    def test_sending_a_prepared_request_directly_uses_the_default(
+        self, httpbin, urlopen_timeouts
+    ):
+        s = self._session((3, 7))
+        s.send(requests.Request("GET", httpbin("get")).prepare())
+        assert [_as_pair(t) for t in urlopen_timeouts] == [(3, 7)]
+
+    def test_every_redirect_hop_uses_the_default(self, httpbin, urlopen_timeouts):
+        s = self._session((3, 7))
+        r = s.get(httpbin("redirect/3"))
+        assert len(r.history) == 3
+        assert [_as_pair(t) for t in urlopen_timeouts] == [(3, 7)] * 4
+
+    def test_the_default_actually_times_a_slow_response_out(self, httpbin):
+        s = self._session((None, 0.1))
+        with pytest.raises(ReadTimeout):
+            s.get(httpbin("delay/1"))
+
+    def test_a_call_timeout_lets_a_slow_response_through(self, httpbin):
+        s = self._session((None, 0.1))
+        assert s.get(httpbin("delay/1"), timeout=5).status_code == 200
+
+    def test_the_default_survives_pickling_the_session(self, httpbin, urlopen_timeouts):
+        s = pickle.loads(pickle.dumps(self._session((3, 7))))
+        s.get(httpbin("get"))
+        assert [_as_pair(t) for t in urlopen_timeouts] == [(3, 7)]
+
+    def test_module_level_calls_are_unaffected(self, httpbin, urlopen_timeouts):
+        requests.get(httpbin("get"))
+        assert [_as_pair(t) for t in urlopen_timeouts] == [(None, None)]
