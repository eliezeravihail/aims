--- a/tests/test_adapters.py
+++ b/tests/test_adapters.py
@@ -1,4 +1,13 @@
+import pickle
+from unittest import mock
+
+import pytest
+import urllib3
+from urllib3.util import Timeout as Urllib3Timeout
+
+import requests
 import requests.adapters
+from requests.adapters import HTTPAdapter
 
 
 def test_request_url_handles_leading_path_separators():
@@ -6,3 +15,181 @@ def test_request_url_handles_leading_path_separators():
     a = requests.adapters.HTTPAdapter()
     p = requests.Request(method="GET", url="http://127.0.0.1:10000//v:h").prepare()
     assert "//v:h" == a.request_url(p, {})
+
+
+# --- A default timeout owned by the transport adapter ------------------------
+#
+# Timeouts are connection behaviour, owned by the transport adapter; Session
+# deliberately holds no timeout. A session gets a default by mounting an
+# adapter that carries one.
+
+
+def _as_pair(timeout):
+    return (timeout.connect_timeout, timeout.read_timeout)
+
+
+@pytest.fixture
+def sent_timeouts():
+    """Record the timeout of every urlopen() call while still sending it."""
+    seen = []
+    real_urlopen = urllib3.connectionpool.HTTPConnectionPool.urlopen
+
+    def recording_urlopen(pool, method, url, *args, **kwargs):
+        seen.append(kwargs["timeout"])
+        return real_urlopen(pool, method, url, *args, **kwargs)
+
+    with mock.patch.object(
+        urllib3.connectionpool.HTTPConnectionPool, "urlopen", recording_urlopen
+    ):
+        yield seen
+
+
+def _session_with(adapter, prefix="http://"):
+    s = requests.Session()
+    s.mount(prefix, adapter)
+    return s
+
+
+class TestAdapterDefaultTimeout:
+    @pytest.mark.parametrize(
+        "default, expected",
+        (
+            (5, (5, 5)),
+            (2.5, (2.5, 2.5)),
+            ((3, 7), (3, 7)),
+            ((None, 7), (None, 7)),
+            (Urllib3Timeout(connect=1, read=9), (1, 9)),
+        ),
+    )
+    def test_request_without_timeout_uses_default(
+        self, httpbin, sent_timeouts, default, expected
+    ):
+        s = _session_with(HTTPAdapter(timeout=default))
+        s.get(httpbin("get"))
+        assert [_as_pair(t) for t in sent_timeouts] == [expected]
+
+    @pytest.mark.parametrize(
+        "per_call, expected",
+        (
+            (4, (4, 4)),
+            ((1, 2), (1, 2)),
+            (Urllib3Timeout(connect=6, read=8), (6, 8)),
+        ),
+    )
+    def test_per_call_timeout_overrides_default(
+        self, httpbin, sent_timeouts, per_call, expected
+    ):
+        s = _session_with(HTTPAdapter(timeout=30))
+        s.get(httpbin("get"), timeout=per_call)
+        assert [_as_pair(t) for t in sent_timeouts] == [expected]
+
+    def test_explicit_none_uses_default(self, httpbin, sent_timeouts):
+        # None cannot mean "wait forever" here: Session.request forwards None
+        # for a call that omitted timeout too, and a passed-through None must
+        # not silently switch the safety default off.
+        s = _session_with(HTTPAdapter(timeout=5))
+        s.get(httpbin("get"), timeout=None)
+        assert [_as_pair(t) for t in sent_timeouts] == [(5, 5)]
+
+    @pytest.mark.parametrize(
+        "no_timeout", ((None, None), Urllib3Timeout(connect=None, read=None))
+    )
+    def test_call_can_opt_out_of_default(self, httpbin, sent_timeouts, no_timeout):
+        s = _session_with(HTTPAdapter(timeout=5))
+        s.get(httpbin("get"), timeout=no_timeout)
+        assert [_as_pair(t) for t in sent_timeouts] == [(None, None)]
+
+    def test_default_applies_to_every_redirect_hop(self, httpbin, sent_timeouts):
+        s = _session_with(HTTPAdapter(timeout=(2, 3)))
+        r = s.get(httpbin("redirect/3"))
+        assert len(r.history) == 3
+        assert [_as_pair(t) for t in sent_timeouts] == [(2, 3)] * 4
+
+    def test_per_call_override_applies_to_every_redirect_hop(
+        self, httpbin, sent_timeouts
+    ):
+        s = _session_with(HTTPAdapter(timeout=(2, 3)))
+        s.get(httpbin("redirect/2"), timeout=11)
+        assert [_as_pair(t) for t in sent_timeouts] == [(11, 11)] * 3
+
+    def test_session_send_without_timeout_uses_default(self, httpbin, sent_timeouts):
+        s = _session_with(HTTPAdapter(timeout=5))
+        prepared = s.prepare_request(requests.Request("GET", httpbin("get")))
+        s.send(prepared)
+        assert [_as_pair(t) for t in sent_timeouts] == [(5, 5)]
+
+    def test_default_is_scoped_to_the_mount_prefix(self, httpbin, sent_timeouts):
+        s = _session_with(HTTPAdapter(timeout=5), prefix="https://")
+        s.get(httpbin("get"))
+        assert [_as_pair(t) for t in sent_timeouts] == [(None, None)]
+
+    def test_default_really_times_out_a_hanging_call(self, httpbin):
+        s = _session_with(HTTPAdapter(timeout=(None, 0.1)))
+        with pytest.raises(requests.exceptions.ReadTimeout):
+            s.get(httpbin("delay/10"))
+
+
+class TestNoDefaultTimeoutUnchanged:
+    def test_plain_adapter_sends_without_timeout(self, httpbin, sent_timeouts):
+        s = _session_with(HTTPAdapter())
+        s.get(httpbin("get"))
+        assert [_as_pair(t) for t in sent_timeouts] == [(None, None)]
+
+    def test_default_session_sends_without_timeout(self, httpbin, sent_timeouts):
+        requests.Session().get(httpbin("get"))
+        assert [_as_pair(t) for t in sent_timeouts] == [(None, None)]
+
+    def test_module_api_sends_without_timeout(self, httpbin, sent_timeouts):
+        requests.get(httpbin("get"))
+        assert [_as_pair(t) for t in sent_timeouts] == [(None, None)]
+
+    def test_session_carries_no_timeout_state(self):
+        s = requests.Session()
+        assert not hasattr(s, "timeout")
+        assert "timeout" not in s.__attrs__
+
+
+class TestInvalidDefaultTimeout:
+    @pytest.mark.parametrize(
+        "bad, error_text",
+        (
+            ((3, 4, 5), "(connect, read)"),
+            ((3,), "(connect, read)"),
+            ("foo", "must be an int, float or None"),
+            (-1, "less than or equal to 0"),
+            (0, "less than or equal to 0"),
+        ),
+    )
+    def test_rejected_when_the_adapter_is_built(self, bad, error_text):
+        with pytest.raises(ValueError) as e:
+            HTTPAdapter(timeout=bad)
+        assert error_text in str(e.value)
+
+    def test_per_call_invalid_tuple_message_unchanged(self, httpbin):
+        s = _session_with(HTTPAdapter(timeout=5))
+        with pytest.raises(ValueError) as e:
+            s.get(httpbin("get"), timeout=(1, 2, 3))
+        assert str(e.value) == (
+            "Invalid timeout (1, 2, 3). Pass a (connect, read) timeout tuple, "
+            "or a single float to set both timeouts to the same value."
+        )
+
+
+class TestDefaultTimeoutPickling:
+    def test_adapter_round_trip_keeps_default(self, httpbin, sent_timeouts):
+        adapter = pickle.loads(pickle.dumps(HTTPAdapter(timeout=(2, 3))))
+        _session_with(adapter).get(httpbin("get"))
+        assert [_as_pair(t) for t in sent_timeouts] == [(2, 3)]
+
+    def test_session_round_trip_keeps_mounted_default(self, httpbin, sent_timeouts):
+        s = pickle.loads(pickle.dumps(_session_with(HTTPAdapter(timeout=4))))
+        s.get(httpbin("get"))
+        assert [_as_pair(t) for t in sent_timeouts] == [(4, 4)]
+
+    def test_state_pickled_before_the_default_existed(self, httpbin, sent_timeouts):
+        state = HTTPAdapter().__getstate__()
+        state.pop("_default_timeout", None)
+        adapter = HTTPAdapter.__new__(HTTPAdapter)
+        adapter.__setstate__(state)
+        _session_with(adapter).get(httpbin("get"))
+        assert [_as_pair(t) for t in sent_timeouts] == [(None, None)]
