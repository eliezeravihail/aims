+def _resolve_timeout(timeout: _t.TimeoutType | TimeoutSauce) -> TimeoutSauce:
+    """Turn a user-facing timeout (float, ``(connect, read)`` tuple, urllib3
+    ``Timeout`` or None) into the urllib3 ``Timeout`` a connection pool takes.
+
+    :raises ValueError: if the value is not a valid timeout.
+    """
+    if isinstance(timeout, tuple):
+        try:
+            connect, read = timeout
