diff --git a/src/requests/sessions.py.md b/src/requests/sessions.py.md
new file mode 100644
index 0000000..52d2a21
--- /dev/null
+++ b/src/requests/sessions.py.md
@@ -0,0 +1,23 @@
+---
+title: "sessions.py"
+date: 2026-09-23
+hash: "sha256:f3dc0ac18ca0635dbc680030f87f8c77512e45c5d658d1e92108f882749015a8"
+---
+## Decisions
+- `Session.timeout` (session default timeout): a per-call `timeout=None` counts as "not given" and the
+  default applies. Rejected: `None` as an explicit "no limit" that overrides the default — wrappers that
+  forward their own `timeout=None` argument (a very common pattern) would silently disable the default and
+  reintroduce the hang-forever calls the feature exists to prevent. The product owner handed this choice
+  to engineering; it was decided on that reason.
+- Per-call opt-out of the default is the already-valid `timeout=(None, None)` / urllib3
+  `Timeout(connect=None, read=None)`, not a new sentinel. Rules out adding a `NO_TIMEOUT`-style constant
+  unless `(None, None)` proves insufficient.
+- A call's timeout replaces the default whole; a `(connect, read)` tuple is never merged field-by-field
+  with the session's. Rules out "call sets read, session supplies connect".
+- The default is a plain attribute validated where per-call timeouts are (the adapter), like `stream` /
+  `verify` / `cert` — no property/validation at assignment. An invalid default fails on first request
+  with the same ValueError as an invalid per-call value.
+## Discussions
+- Resolution lives only in `Session.send`: every path (verb methods → `request`, direct `send`,
+  `Response.next`, redirect hops, response hooks) passes through it. `merge_environment_settings` was the
+  other candidate; rejected because direct `send()` bypasses it.
diff --git a/tests/test_requests.py b/tests/test_requests.py
index 8bcb81d..1f13196 100644
--- a/tests/test_requests.py
+++ b/tests/test_requests.py
@@ -2605,6 +2605,173 @@ class TestTimeout:
 SendCall = collections.namedtuple("SendCall", ("args", "kwargs"))
 
 
+class _RecordingAdapter(HTTPAdapter):
+    """Records the ``timeout`` each send reaches the transport with."""
+
+    def __init__(self):
+        super().__init__()
+        self.timeouts = []
+
+    def send(self, request, **kwargs):
+        self.timeouts.append(kwargs["timeout"])
+        return super().send(request, **kwargs)
+
+
+def _recording_session(default=None, configure=True):
+    s = requests.Session()
+    if configure:
+        s.timeout = default
+    adapter = _RecordingAdapter()
+    s.mount("http://", adapter)
+    return s, adapter
+
+
+class TestSessionDefaultTimeout:
+    # --- no default configured: behavior is exactly as before -----------------
+
+    @pytest.mark.parametrize(
+        "kwargs, expected",
+        (
+            ({}, None),
+            ({"timeout": None}, None),
+            ({"timeout": 5}, 5),
+            ({"timeout": (1, 2)}, (1, 2)),
+        ),
+    )
+    def test_without_default_timeout_reaches_adapter_as_passed(
+        self, httpbin, kwargs, expected
+    ):
+        s, adapter = _recording_session(configure=False)
+        s.get(httpbin("get"), **kwargs)
+        assert adapter.timeouts == [expected]
+
+    def test_new_session_has_no_default(self):
+        assert requests.Session().timeout is None
+
+    # --- default configured ----------------------------------------------------
+
+    @pytest.mark.parametrize(
+        "method", ("get", "options", "head", "post", "put", "patch", "delete")
+    )
+    def test_default_applies_to_every_verb_method(self, httpbin, method):
+        s, adapter = _recording_session(default=7)
+        getattr(s, method)(httpbin(method if method not in ("options", "head") else "get"))
+        assert adapter.timeouts == [7]
+
+    def test_default_applies_to_request(self, httpbin):
+        s, adapter = _recording_session(default=7)
+        s.request("GET", httpbin("get"))
+        assert adapter.timeouts == [7]
+
+    def test_explicit_none_uses_default(self, httpbin):
+        """A forwarded ``timeout=None`` must not silently disable the default."""
+        s, adapter = _recording_session(default=7)
+        s.get(httpbin("get"), timeout=None)
+        assert adapter.timeouts == [7]
+
+    @pytest.mark.parametrize(
+        "timeout",
+        (3, 0.5, (1, 30), (None, 30), Urllib3Timeout(connect=1, read=2)),
+    )
+    def test_per_call_timeout_replaces_default_whole(self, httpbin, timeout):
+        s, adapter = _recording_session(default=(9, 99))
+        s.get(httpbin("get"), timeout=timeout)
+        assert adapter.timeouts == [timeout]
+
+    @pytest.mark.parametrize(
+        "no_limit", ((None, None), Urllib3Timeout(connect=None, read=None))
+    )
+    def test_explicit_no_limit_opts_out_of_default(self, httpbin, no_limit):
+        s, adapter = _recording_session(default=7)
+        r = s.get(httpbin("get"), timeout=no_limit)
+        assert r.status_code == 200
+        assert adapter.timeouts == [no_limit]
+
+    @pytest.mark.parametrize(
+        "default", (7, (1, 30), Urllib3Timeout(connect=1, read=30))
+    )
+    def test_default_value_shapes_reach_adapter_unchanged(self, httpbin, default):
+        s, adapter = _recording_session(default=default)
+        s.get(httpbin("get"))
+        assert adapter.timeouts == [default]
+
+    def test_default_applies_to_direct_send(self, httpbin):
+        s, adapter = _recording_session(default=7)
+        prep = s.prepare_request(requests.Request("GET", httpbin("get")))
+        s.send(prep)
+        assert adapter.timeouts == [7]
+
+    def test_direct_send_with_explicit_timeout_wins(self, httpbin):
+        s, adapter = _recording_session(default=7)
+        prep = s.prepare_request(requests.Request("GET", httpbin("get")))
+        s.send(prep, timeout=2)
+        assert adapter.timeouts == [2]
+
+    def test_default_applies_to_every_redirect_hop(self, httpbin):
+        s, adapter = _recording_session(default=7)
+        r = s.get(httpbin("redirect/2"))
+        assert len(r.history) == 2
+        assert adapter.timeouts == [7, 7, 7]
+
+    def test_per_call_timeout_applies_to_every_redirect_hop(self, httpbin):
+        s, adapter = _recording_session(default=7)
+        s.get(httpbin("redirect/2"), timeout=3)
+        assert adapter.timeouts == [3, 3, 3]
+
+    def test_default_applies_when_following_response_next(self, httpbin):
+        s, adapter = _recording_session(default=7)
+        r = s.get(httpbin("redirect/1"), allow_redirects=False)
+        s.send(r.next)
+        assert adapter.timeouts == [7, 7]
+
+    def test_hooks_see_effective_timeout(self, httpbin):
+        seen = []
+
+        def hook(r, **kwargs):
+            seen.append(kwargs["timeout"])
+
+        s, _ = _recording_session(default=7)
+        s.get(httpbin("get"), hooks={"response": hook})
+        assert seen == [7]
+
+    def test_default_changed_later_applies_to_later_requests(self, httpbin):
+        s, adapter = _recording_session(default=7)
+        s.get(httpbin("get"))
+        s.timeout = None
+        s.get(httpbin("get"))
+        assert adapter.timeouts == [7, None]
+
+    def test_default_read_timeout_fires_without_per_call_timeout(self, httpbin):
+        with requests.Session() as s:
+            s.timeout = (None, 0.1)
+            with pytest.raises(ReadTimeout):
+                s.get(httpbin("delay/10"))
+
+    def test_invalid_default_fails_like_invalid_per_call_timeout(self, httpbin):
+        s, _ = _recording_session(default=(3, 4, 5))
+        with pytest.raises(ValueError, match=r"\(connect, read\)"):
+            s.get(httpbin("get"))
+
+    # --- persistence -----------------------------------------------------------
+
+    def test_default_survives_pickling(self, httpbin):
+        s = requests.Session()
+        s.timeout = (1, 30)
+        assert pickle.loads(pickle.dumps(s)).timeout == (1, 30)
+
+    def test_session_pickled_before_default_existed_has_no_default(self, httpbin):
+        s = requests.Session()
+        state = s.__getstate__()
+        del state["timeout"]
+        old = requests.Session.__new__(requests.Session)
+        old.__setstate__(state)
+        assert old.timeout is None
+        adapter = _RecordingAdapter()
+        old.mount("http://", adapter)
+        old.get(httpbin("get"))
+        assert adapter.timeouts == [None]
+
+
 class RedirectSession(SessionRedirectMixin):
     def __init__(self, order_of_redirects):
         self.redirects = order_of_redirects
