@@ -0,0 +1,28 @@
+---
+title: "sessions.py"
+date: 2026-09-23
+hash: "sha256:10993fa9be01182ad467c84a11735c03c345374d6f7f702e017f938c1cec55d8"
+---
+## Decisions
+- `Session.timeout`: on a session with a default, a per-call `timeout=None` means "use the default".
+  It does not mean "wait forever". The product owner delegated this choice. It was taken because the
+  feature exists to stop calls that hang, and because code that forwards `timeout=None` from a wrapper's
+  own default argument must not reopen that hang. This rules out waiting forever on one call while the
+  session has a default: such a call passes a large finite value, or uses a session with no default.
+  It also narrows the documented "`None` = wait forever" to sessions without a default.
+- The resolution lives in `send()` and nowhere else, because `request()`, a direct `send()`, each
+  redirect hop (`resolve_redirects` re-enters `send`) and hook re-sends (digest auth calls
+  `r.connection.send(prep, **kwargs)`) all pass through it or its kwargs. Resolving in `request()` was
+  rejected because a direct `send()` would then bypass the default.
+- A per-call value replaces the default wholesale. `timeout=5` on a `(3, 30)` default is `5`, not
+  `(5, 30)`. Merging per component was not offered, because it is not the rule the product owner stated.
+## Discussions
+- Rejected alternative: a sentinel that tells "omitted" apart from an explicit `None`. It would keep
+  `None` = forever as a per-call opt-out. It was dropped because it needs a new public sentinel, departs
+  from how `verify`/`stream`/`proxies` fall back to the session, and keeps the forwarded-`None` hang the
+  feature is meant to remove. Revisit only if users need an unbounded call on a session with a default.
+- Side effect accepted: `send()` now always puts a `timeout` key in the adapter/hook kwargs, even for
+  a direct `send(prep)` on a session with no default. Before, that one path omitted the key, and
+  `HTTPAdapter` defaulted it to `None`. The effective timeout is the same. Only a mock that asserts the
+  exact kwargs of a direct `send()` would see the difference. This matches how `send()` already fills
+  in `stream`/`verify`/`cert`.
diff --git a/tests/test_session_timeout.py b/tests/test_session_timeout.py
new file mode 100644
index 0000000..d92d74b
--- /dev/null
+++ b/tests/test_session_timeout.py
@@ -0,0 +1,221 @@
+"""Tests for the timeout a Session hands its adapters.
+
+A recording adapter stands in for the network, so these tests pin exactly
+which ``timeout`` reaches the adapter on every path through a Session:
+``request()``, a direct ``send()``, each redirect hop, and a hook re-send.
+"""
+
+import pickle
+
+import pytest
+from urllib3.util import Timeout as Urllib3Timeout
+
+import requests
+from requests.adapters import BaseAdapter
+from requests.models import Response
+from requests.structures import CaseInsensitiveDict
+
+URL = "http://example.test/start"
+
+
+class RecordingAdapter(BaseAdapter):
+    """Answers with ``redirects`` 302s before a 200, recording each send."""
+
+    def __init__(self, redirects=0):
+        super().__init__()
+        self.redirects = redirects
+        self.timeouts = []
+
+    def send(self, request, stream=False, timeout=None, verify=True, cert=None,
+             proxies=None):
+        self.timeouts.append(timeout)
+        resp = Response()
+        resp.request = request
+        resp.url = request.url
+        resp.headers = CaseInsensitiveDict()
+        resp._content = b""
+        resp._content_consumed = True
+        resp.connection = self
+        if len(self.timeouts) <= self.redirects:
+            resp.status_code = 302
+            resp.headers["Location"] = f"/hop{len(self.timeouts)}"
+        else:
+            resp.status_code = 200
+        return resp
+
+    def close(self):
+        pass
+
+
+def make_session(redirects=0):
+    s = requests.Session()
+    s.trust_env = False
+    adapter = RecordingAdapter(redirects)
+    s.mount("http://", adapter)
+    return s, adapter
+
+
+class TestNoSessionDefault:
+    """Characterization: a Session with no default is unchanged."""
+
+    def test_default_is_none(self):
+        assert requests.Session().timeout is None
+
+    def test_request_without_timeout_sends_none(self):
+        s, adapter = make_session()
+        s.get(URL)
+        assert adapter.timeouts == [None]
+
+    def test_request_timeout_is_passed_through(self):
+        s, adapter = make_session()
+        s.get(URL, timeout=(3, 7))
+        assert adapter.timeouts == [(3, 7)]
+
+    def test_direct_send_without_timeout_sends_none(self):
+        s, adapter = make_session()
+        s.send(s.prepare_request(requests.Request("GET", URL)))
+        assert adapter.timeouts == [None]
+
+    def test_redirect_hops_send_none(self):
+        s, adapter = make_session(redirects=2)
+        r = s.get(URL)
+        assert len(r.history) == 2
+        assert adapter.timeouts == [None, None, None]
+
+
+class TestSessionDefault:
+    def test_request_without_timeout_uses_default(self):
+        s, adapter = make_session()
+        s.timeout = 5
+        s.get(URL)
+        assert adapter.timeouts == [5]
+
+    @pytest.mark.parametrize("method", ["get", "options", "head", "post", "put",
+                                        "patch", "delete"])
+    def test_every_verb_uses_default(self, method):
+        s, adapter = make_session()
+        s.timeout = 5
+        getattr(s, method)(URL)
+        assert adapter.timeouts == [5]
+
+    def test_per_call_timeout_overrides_default(self):
+        s, adapter = make_session()
+        s.timeout = 5
+        s.get(URL, timeout=2)
+        assert adapter.timeouts == [2]
+
+    def test_per_call_scalar_replaces_tuple_default_wholesale(self):
+        s, adapter = make_session()
+        s.timeout = (3, 30)
+        s.get(URL, timeout=5)
+        assert adapter.timeouts == [5]
+
+    def test_per_call_tuple_replaces_scalar_default_wholesale(self):
+        s, adapter = make_session()
+        s.timeout = 5
+        s.get(URL, timeout=(1, None))
+        assert adapter.timeouts == [(1, None)]
+
+    def test_explicit_none_falls_back_to_default(self):
+        # The chosen rule: None never means "wait forever" on a session that
+        # has a default, so a wrapper forwarding timeout=None cannot hang.
+        s, adapter = make_session()
+        s.timeout = 5
+        s.get(URL, timeout=None)
+        assert adapter.timeouts == [5]
+
+    def test_zero_is_a_concrete_timeout_not_a_fallback(self):
+        s, adapter = make_session()
+        s.timeout = 5
+        s.get(URL, timeout=0)
+        assert adapter.timeouts == [0]
+
+    def test_urllib3_timeout_object_as_default(self):
+        s, adapter = make_session()
+        s.timeout = Urllib3Timeout(connect=1, read=2)
+        s.get(URL)
+        assert adapter.timeouts == [s.timeout]
+
+    def test_direct_send_uses_default(self):
+        s, adapter = make_session()
+        s.timeout = 5
+        s.send(s.prepare_request(requests.Request("GET", URL)))
+        assert adapter.timeouts == [5]
+
+    def test_direct_send_with_explicit_none_uses_default(self):
+        s, adapter = make_session()
+        s.timeout = 5
+        s.send(s.prepare_request(requests.Request("GET", URL)), timeout=None)
+        assert adapter.timeouts == [5]
+
+    def test_direct_send_override(self):
+        s, adapter = make_session()
+        s.timeout = 5
+        s.send(s.prepare_request(requests.Request("GET", URL)), timeout=1)
+        assert adapter.timeouts == [1]
+
+    def test_redirect_hops_use_default(self):
+        s, adapter = make_session(redirects=2)
+        s.timeout = 5
+        s.get(URL)
+        assert adapter.timeouts == [5, 5, 5]
+
+    def test_redirect_hops_use_per_call_override(self):
+        s, adapter = make_session(redirects=2)
+        s.timeout = 5
+        s.get(URL, timeout=2)
+        assert adapter.timeouts == [2, 2, 2]
+
+    def test_response_hook_receives_resolved_timeout(self):
+        # HTTPDigestAuth re-sends via r.connection.send(prep, **kwargs), so
+        # the kwargs a hook receives must carry the resolved timeout.
+        s, adapter = make_session()
+        s.timeout = 5
+        seen = []
+
+        def hook(r, **kwargs):
+            seen.append(kwargs["timeout"])
+            r.connection.send(r.request, **kwargs)
+
+        s.get(URL, hooks={"response": hook})
+        assert seen == [5]
+        assert adapter.timeouts == [5, 5]
+
+    def test_changing_default_affects_later_requests(self):
+        s, adapter = make_session()
+        s.timeout = 5
+        s.get(URL)
+        s.timeout = None
+        s.get(URL)
+        assert adapter.timeouts == [5, None]
+
+    def test_module_level_api_is_unaffected(self, monkeypatch):
+        seen = []
+
+        def fake_send(self, request, **kwargs):
+            seen.append(kwargs.get("timeout"))
+            raise RuntimeError("stop")
+
+        monkeypatch.setattr(requests.adapters.HTTPAdapter, "send", fake_send)
+        with pytest.raises(RuntimeError):
+            requests.get(URL)
+        assert seen == [None]
+
+
+class TestPickling:
+    def test_default_survives_pickle(self):
+        s = requests.Session()
+        s.timeout = (3, 30)
+        assert pickle.loads(pickle.dumps(s)).timeout == (3, 30)
+
+    def test_state_from_before_the_setting_existed_loads_with_no_default(self):
+        state = requests.Session().__getstate__()
+        del state["timeout"]
+        s = requests.Session.__new__(requests.Session)
+        s.__setstate__(state)
+        assert s.timeout is None
+        adapter = RecordingAdapter()
+        s.mount("http://", adapter)
+        s.trust_env = False
+        s.get(URL)
+        assert adapter.timeouts == [None]
