+class _EpochProgress:
+    r"""Where one iteration (epoch) of a :class:`RandomSampler` is.
+
+    ``start_state`` is the state of the generator just before the iteration drew
+    its first random number, so replaying the iteration's draws from it recreates
+    its order. The position is counted without per-sample work: ``_entered`` is the
+    number of samples in all blocks the iteration has entered, and ``_block`` is the
+    list iterator currently being yielded from, whose exact remaining length is
+    subtracted.
+    """
+
+    __slots__ = ("start_state", "finished", "_entered", "_block")
+
+    def __init__(self) -> None:
+        self.start_state: torch.Tensor | None = None  # None until the order is fixed
+        self.finished = False
+        self._entered = 0
+        self._block: Iterator[int] = iter(())
+
+    def enter(self, block: list[int], position: int) -> Iterator[int]:
+        # ``position`` is where ``block``'s first element sits within the epoch.
+        self._block = iter(block)
+        self._entered = position + len(block)
+        return self._block
+
+    @property
+    def position(self) -> int:
+        return self._entered - operator.length_hint(self._block)
+
