+class TestRandomSamplerStateDict(TestCase):
+    # (replacement, num_samples, len(data)): one draw, several draws with a partial
+    # last one, and draws that end exactly on a block boundary (32 with
+    # replacement, len(data) without).
+    CONFIGS = [
+        (False, None, 10),
+        (False, 7, 10),
+        (False, 25, 10),
+        (False, 20, 10),
+        (True, None, 10),
+        (True, 5, 1000),
+        (True, 70, 3),
+        (True, 64, 3),
+    ]
+
+    def _interrupt(self, sampler, k):
+        # Take k indices from a fresh iteration and checkpoint the sampler through
+        # a pickle round trip, as a real checkpoint would be.
+        it = iter(sampler)
+        head = list(itertools.islice(it, k))
+        state = pickle.loads(pickle.dumps(sampler.state_dict()))
+        return head, state, it
+
+    def _positions(self, total):
+        return sorted(
+            {1, 2, 9, 10, 11, 31, 32, 33, total - 1, total} & set(range(1, total + 1))
+        )
+
+    @parametrize("use_generator", [False, True])
+    def test_resume_yields_the_rest_then_shuffles_as_usual(self, use_generator):
+        def make(replacement, num_samples, n, seed):
+            gen = torch.Generator().manual_seed(seed) if use_generator else None
+            return RandomSampler(range(n), replacement, num_samples, gen)
+
+        for replacement, num_samples, n in self.CONFIGS:
+            total = num_samples or n
+            for k in self._positions(total):
+                with self.subTest(
+                    replacement=replacement, num_samples=num_samples, n=n, k=k
+                ):
+                    torch.manual_seed(0)
+                    sampler = make(replacement, num_samples, n, seed=1)
+                    head, state, it = self._interrupt(sampler, k)
+                    global_rng = torch.get_rng_state()
+                    tail = list(it)
+                    later = list(sampler) + list(sampler)
+
+                    # The restarted job restores the global RNG (as it would from
+                    # its checkpoint), but builds its generator anew.
+                    torch.manual_seed(1234)
+                    torch.set_rng_state(global_rng)
+                    resumed = make(replacement, num_samples, n, seed=2)
+                    resumed.load_state_dict(state)
+                    self.assertEqual(state["position"], k)
+                    self.assertEqual(list(resumed), tail)
+                    self.assertEqual(len(head) + len(tail), total)
+                    # Later epochs are full, and follow the same RNG streams the
+                    # uninterrupted run did.
+                    self.assertEqual(list(resumed) + list(resumed), later)
+
+    def test_resume_leaves_rng_where_uninterrupted_run_would(self):
+        for replacement, num_samples, n in self.CONFIGS:
+            with self.subTest(replacement=replacement, num_samples=num_samples, n=n):
+                gen = torch.Generator().manual_seed(3)
+                sampler = RandomSampler(range(n), replacement, num_samples, gen)
+                _, state, it = self._interrupt(sampler, 1)
+                list(it)
+                torch.manual_seed(5)
+                global_rng = torch.get_rng_state()
+
+                # With a generator: it ends the epoch in the same state.
+                other = torch.Generator().manual_seed(4)
+                resumed = RandomSampler(range(n), replacement, num_samples, other)
+                resumed.load_state_dict(state)
+                list(resumed)
+                self.assertEqual(other.get_state(), gen.get_state())
+                # Without one: the global RNG is not drawn from.
+                self.assertEqual(torch.get_rng_state(), global_rng)
+                resumed = RandomSampler(range(n), replacement, num_samples)
+                resumed.load_state_dict(state)
+                list(resumed)
+                self.assertEqual(torch.get_rng_state(), global_rng)
+
+    def test_state_dict_between_iterations(self):
+        sampler = RandomSampler(range(10))
+        # Never iterated, created but not yet drawn, and run to completion: nothing
+        # to resume, so the next iteration is a fresh, full one.
+        states = [sampler.state_dict()]
+        it = iter(sampler)
+        states.append(sampler.state_dict())
+        self.assertEqual(len(list(it)), 10)
+        states.append(sampler.state_dict())
+        for state in states:
+            self.assertIsNone(state["generator_state"])
+            self.assertEqual(state["position"], 0)
+            resumed = RandomSampler(range(10))
+            resumed.load_state_dict(state)
+            self.assertEqual(sorted(resumed), list(range(10)))
+
+        # All indices yielded, but the iteration not yet exhausted: its rest is empty.
+        it = iter(sampler)
+        list(itertools.islice(it, 10))
+        resumed = RandomSampler(range(10))
+        resumed.load_state_dict(sampler.state_dict())
+        self.assertEqual(list(resumed), [])
+        self.assertEqual(sorted(resumed), list(range(10)))
+
+        # The newest iteration is the one described, even if an older one was left
+        # unfinished.
+        old = iter(sampler)
+        list(itertools.islice(old, 4))
+        new = iter(sampler)
+        next(new)
+        self.assertEqual(sampler.state_dict()["position"], 1)
+
+    def test_checkpoint_again_while_resuming(self):
+        gen = torch.Generator().manual_seed(0)
+        full = list(RandomSampler(range(50), generator=gen))
+        gen = torch.Generator().manual_seed(0)
+        _, state, _ = self._interrupt(RandomSampler(range(50), generator=gen), 10)
+
+        # Checkpointing again before the resumed iteration has made progress,
+        # whether or not it was started, keeps the loaded position.
+        sampler = RandomSampler(range(50))
+        sampler.load_state_dict(state)
+        self.assertEqual(sampler.state_dict()["position"], 10)
+        it = iter(sampler)
+        self.assertEqual(sampler.state_dict()["position"], 10)
+        # Preempted again mid-way: the position counts from the original epoch start.
+        list(itertools.islice(it, 15))
+        state = sampler.state_dict()
+        self.assertEqual(state["position"], 25)
+        sampler = RandomSampler(range(50))
+        sampler.load_state_dict(state)
+        self.assertEqual(list(sampler), full[25:])
+
+    def test_state_is_independent_of_the_sampler(self):
+        sampler = RandomSampler(range(10))
+        _, state, it = self._interrupt(sampler, 3)
+        rest = list(it)
+        # Mutating the returned or loaded state does not change the sampler.
+        resumed = RandomSampler(range(10))
+        resumed.load_state_dict(state)
+        state["generator_state"].zero_()
+        state["position"] = 0
+        resumed.state_dict()["generator_state"].zero_()
+        self.assertEqual(list(resumed), rest)
+
+    def test_state_dict_loads_with_weights_only(self):
+        sampler = RandomSampler(range(10))
+        _, state, it = self._interrupt(sampler, 4)
+        with tempfile.TemporaryFile() as f:
+            torch.save({"sampler": state}, f)
+            f.seek(0)
+            loaded = torch.load(f, weights_only=True)["sampler"]
+        resumed = RandomSampler(range(10))
+        resumed.load_state_dict(loaded)
+        self.assertEqual(list(resumed), list(it))
+
+    def test_load_state_dict_rejects_mismatched_or_malformed_state(self):
+        _, state, _ = self._interrupt(RandomSampler(range(10), num_samples=12), 3)
+        for sampler, pattern in [
+            (RandomSampler(range(11), num_samples=12), "data_len=10"),
+            (RandomSampler(range(10), num_samples=13), "num_samples=12"),
+            (RandomSampler(range(10), True, 12), "replacement=False"),
+        ]:
+            with self.assertRaisesRegex(ValueError, pattern):
+                sampler.load_state_dict(state)
+        sampler = RandomSampler(range(10), num_samples=12)
+        for bad in [
+            {**state, "position": 13},
+            {**state, "position": -1},
+            {**state, "position": 2.0},
+            {**state, "generator_state": [1, 2]},
+            {**state, "generator_state": torch.zeros(3, dtype=torch.uint8)},
+            {**state, "generator_state": None},
+            {k: v for k, v in state.items() if k != "position"},
+            {**state, "extra": 1},
+            [state],
+        ]:
+            with self.assertRaises(ValueError):
+                sampler.load_state_dict(bad)
+        # A rejected state leaves the sampler as it was: a fresh, full iteration.
+        self.assertEqual(len(list(sampler)), 12)
+
+    def test_dataloader_without_workers_resumes_exactly(self):
+        dataset = list(range(30))
+
+        def epoch(loader_or_iter):
+            return [batch.tolist() for batch in loader_or_iter]
+
+        for use_generator in (False, True):
+            with self.subTest(use_generator=use_generator):
+
+                def make(seed):
+                    gen = torch.Generator().manual_seed(seed) if use_generator else None
+                    return DataLoader(dataset, batch_size=4, shuffle=True, generator=gen)
+
+                loader = make(0)
+                it = iter(loader)
+                list(itertools.islice(it, 3))
+                state = loader.sampler.state_dict()
+                self.assertEqual(state["position"], 12)
+                tail = epoch(it)
+                next_epoch = epoch(loader)
+
+                loader = make(1)
+                loader.sampler.load_state_dict(state)
+                self.assertEqual(epoch(loader), tail)
+                resumed_next_epoch = epoch(loader)
+                self.assertEqual(sorted(sum(resumed_next_epoch, [])), dataset)
+                if use_generator:
+                    # The DataLoader draws its worker base seed from the shared
+                    # generator before the sampler starts; the resumed epoch must
+                    # still leave the generator where the uninterrupted run did.
+                    self.assertEqual(resumed_next_epoch, next_epoch)
+
+
+instantiate_parametrized_tests(TestRandomSamplerStateDict)
