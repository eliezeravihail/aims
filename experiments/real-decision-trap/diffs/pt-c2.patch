+    def state_dict(self) -> dict[str, Any]:
+        r"""Return the sampler's position as a picklable ``dict``.
+
+        Passing it to :meth:`load_state_dict` of a new :class:`RandomSampler` over
+        the same data (same length, ``replacement`` and ``num_samples``) makes that
+        sampler's next iteration yield exactly the samples the current iteration
+        has not yet yielded, in the same order. If the current iteration has
+        finished (or none was started), the next iteration is a new epoch.
+
+        The position is that of the most recently started iteration, counted in
+        samples the sampler has yielded. ``state["yielded"]`` holds that count.
+
+        .. note::
+            A :class:`~torch.utils.data.DataLoader` with ``num_workers > 0``
+            draws indices ahead of the batches it has returned, up to
+            ``prefetch_factor * num_workers`` batches. The sampler's position is
+            then ahead of the training loop's: resuming from it skips the
+            prefetched samples. To resume from what the loop actually received,
+            set ``state["yielded"]`` to the number of samples of this epoch the
+            loop has consumed (with the default ``in_order=True``) before loading it.
+        """
+        generator_state = (
+            None if self.generator is None else self.generator.get_state()
+        )
+        if self._resume is not None:
+            # Loaded but not yet resumed: the position is still the loaded one.
+            return {**self._resume, "generator_state": generator_state}
+        epoch = self._epoch
+        if epoch is None:
+            return {
+                "num_data": len(self.data_source),
+                "num_samples": self.num_samples,
+                "replacement": self.replacement,
+                "yielded": 0,
+                "epoch_seed": None,
+                "epoch_generator_state": None,
+                "generator_state": generator_state,
+            }
+        return {
+            "num_data": epoch.num_data,
+            "num_samples": epoch.num_samples,
+            "replacement": self.replacement,
+            "yielded": epoch.yielded,
+            "epoch_seed": epoch.seed,
+            "epoch_generator_state": (
+                None if epoch.generator_state is None else epoch.generator_state.clone()
+            ),
+            "generator_state": generator_state,
+        }
+
+    def load_state_dict(self, state_dict: dict[str, Any]) -> None:
+        r"""Restore a position saved by :meth:`state_dict`.
+
+        If the saved iteration had not finished, the next iteration of this
+        sampler yields the samples it had not yet yielded, in the same order;
+        iterations after that are shuffled as usual. Otherwise the next iteration
+        is a new epoch.
+
+        If this sampler has a ``generator``, its state is restored as well, so
+        the epochs that follow are the ones the interrupted run would have drawn.
+        Without a ``generator``, later epochs are seeded from PyTorch's global
+        random number generator, as usual.
+
+        Raises:
+            ValueError: if ``state_dict`` is malformed, or was saved for data of a
+                different length, or a sampler with a different ``replacement``
+                or ``num_samples``.
+        """
