+class TestRandomSamplerStateDict(TestCase):
+    # (len(data), replacement, num_samples): one permutation, several, a
+    # truncated one, a multiple of the length, and with replacement several
+    # 32-sample blocks, a partial one and an exact multiple of 32.
+    CONFIGS = [
+        (10, False, None),
+        (10, False, 25),
+        (10, False, 30),
+        (10, False, 3),
+        (20, True, None),
+        (20, True, 70),
+        (20, True, 64),
+    ]
+
+    @staticmethod
+    def _generator(seed):
+        return torch.Generator().manual_seed(seed)
+
+    def _sampler(self, n, replacement, num_samples, generator):
+        from torch.utils.data import RandomSampler
+
+        return RandomSampler(range(n), replacement, num_samples, generator)
+
+    def _roundtrip(self, state):
+        buffer = io.BytesIO()
+        torch.save(state, buffer)
+        buffer.seek(0)
+        return torch.load(buffer, weights_only=True)
+
+    def test_resume_with_generator_at_every_position(self):
+        for n, replacement, num_samples in self.CONFIGS:
+            reference = self._sampler(n, replacement, num_samples, self._generator(0))
+            epochs = [list(reference) for _ in range(3)]
+            for k in range(len(reference) + 1):
+                with self.subTest(n=n, replacement=replacement, num_samples=num_samples, k=k):
+                    sampler = self._sampler(n, replacement, num_samples, self._generator(0))
+                    seen = list(itertools.islice(iter(sampler), k))
+                    state = self._roundtrip(sampler.state_dict())
+
+                    # A new process: same data, generator seeded differently.
+                    resumed = self._sampler(n, replacement, num_samples, self._generator(1))
+                    resumed.load_state_dict(state)
+                    if k < len(reference):
+                        self.assertEqual(seen + list(resumed), epochs[0])
+                    else:
+                        # The epoch had finished: the next iteration is a new one.
+                        self.assertEqual(seen, epochs[0])
+                    # Later epochs are the ones the uninterrupted run drew.
+                    self.assertEqual([list(resumed), list(resumed)], epochs[1:3])
+
+    def test_resume_without_generator_at_every_position(self):
+        for n, replacement, num_samples in self.CONFIGS:
+            torch.manual_seed(0)
+            reference = self._sampler(n, replacement, num_samples, None)
+            first_epoch = list(reference)
+            # From k=1: until a sample is drawn no order exists, and a sampler
+            # without a generator is free to draw a new one.
+            for k in range(1, len(reference)):
+                with self.subTest(n=n, replacement=replacement, num_samples=num_samples, k=k):
+                    torch.manual_seed(0)
+                    sampler = self._sampler(n, replacement, num_samples, None)
+                    seen = list(itertools.islice(iter(sampler), k))
+                    state = self._roundtrip(sampler.state_dict())
+
+                    torch.manual_seed(1)
+                    resumed = self._sampler(n, replacement, num_samples, None)
+                    resumed.load_state_dict(state)
+                    self.assertEqual(seen + list(resumed), first_epoch)
+
+    def test_later_epochs_without_generator_are_shuffled(self):
+        sampler = self._sampler(100, False, None, None)
+        it = iter(sampler)
+        next(it)
+        resumed = self._sampler(100, False, None, None)
+        resumed.load_state_dict(sampler.state_dict())
+        self.assertEqual(len(list(resumed)), 99)
+        later = [list(resumed) for _ in range(2)]
+        for epoch in later:
+            self.assertEqual(sorted(epoch), list(range(100)))
+        self.assertNotEqual(later[0], later[1])
+
+    def test_state_is_picklable(self):
+        for generator in (None, self._generator(0)):
+            sampler = self._sampler(10, False, None, generator)
+            it = iter(sampler)
+            seen = [next(it) for _ in range(4)]
+            state = pickle.loads(pickle.dumps(sampler.state_dict()))
+            resumed = self._sampler(10, False, None, None)
+            resumed.load_state_dict(state)
+            self.assertEqual(seen + list(resumed), seen + list(it))
+
+    def test_state_dict_before_any_iteration(self):
+        sampler = self._sampler(10, False, None, self._generator(0))
+        state = sampler.state_dict()
+        self.assertEqual(state["yielded"], 0)
+        expected = list(self._sampler(10, False, None, self._generator(0)))
+        resumed = self._sampler(10, False, None, self._generator(1))
+        resumed.load_state_dict(state)
+        self.assertEqual(list(resumed), expected)
+
+    def test_state_dict_of_a_loaded_sampler(self):
+        # Checkpointing again before the resumed iteration starts, or partway
+        # through it, keeps the position.
+        sampler = self._sampler(10, False, 25, None)
+        it = iter(sampler)
+        list(itertools.islice(it, 7))
+        state = sampler.state_dict()
+        rest = list(it)
+
+        first = self._sampler(10, False, 25, None)
+        first.load_state_dict(state)
+        second = self._sampler(10, False, 25, None)
+        second.load_state_dict(first.state_dict())
+        it = iter(second)
+        self.assertEqual(list(itertools.islice(it, 5)), rest[:5])
+        third = self._sampler(10, False, 25, None)
+        third.load_state_dict(second.state_dict())
+        self.assertEqual(list(third), rest[5:])
+
+    def test_state_follows_most_recent_iteration(self):
+        sampler = self._sampler(10, False, None, self._generator(0))
+        abandoned = iter(sampler)
+        next(abandoned)
+        current = iter(sampler)
+        seen = [next(current) for _ in range(3)]
+        resumed = self._sampler(10, False, None, self._generator(1))
+        resumed.load_state_dict(sampler.state_dict())
+        self.assertEqual(seen + list(resumed), seen + list(current))
+
+    def test_rewind_yielded(self):
+        sampler = self._sampler(20, True, 70, self._generator(0))
+        it = iter(sampler)
+        seen = list(itertools.islice(it, 50))
+        state = sampler.state_dict()
+        self.assertEqual(state["yielded"], 50)
+        state["yielded"] = 12
+        resumed = self._sampler(20, True, 70, self._generator(1))
+        resumed.load_state_dict(state)
+        self.assertEqual(seen[:12] + list(resumed), seen + list(it))
+
+    def test_resume_through_dataloader(self):
+        # The DataLoader draws its base seed from the sampler's generator too;
+        # a resumed run must still match an uninterrupted one epoch for epoch.
+        dataset = list(range(25))
+
+        def make_loader():
+            generator = torch.Generator().manual_seed(0)
+            return DataLoader(dataset, batch_size=4, shuffle=True, generator=generator)
+
+        def run(loader, epochs):
+            return [[b.tolist() for b in loader] for _ in range(epochs)]
+
+        uninterrupted = run(make_loader(), 3)
+        for stop_after in (1, 3, 7):  # batches; 7 is the whole first epoch
+            with self.subTest(stop_after=stop_after):
+                loader = make_loader()
+                received = [b.tolist() for b in itertools.islice(loader, stop_after)]
+                state = self._roundtrip(loader.sampler.state_dict())
+
+                resumed = make_loader()
+                resumed.sampler.load_state_dict(state)
+                later = run(resumed, 2)
+                if stop_after < 7:
+                    epochs = [received + later[0], later[1]]
+                else:
+                    epochs = [received, *later]
+                self.assertEqual(epochs, uninterrupted[: len(epochs)])
+
+    def test_resume_through_multiprocess_dataloader(self):
+        # With workers the sampler runs ahead of the batches returned; the
+        # documented recipe is to set ``yielded`` to what the loop consumed.
+        # After 9 of 10 batches the sampler has already finished the epoch.
+        dataset = list(range(40))
+
+        def make_loader(seed):
+            return DataLoader(
+                dataset,
+                batch_size=4,
+                shuffle=True,
+                generator=torch.Generator().manual_seed(seed),
+                num_workers=2,
+            )
+
+        for stop_after in (3, 9):
+            with self.subTest(stop_after=stop_after):
+                loader = make_loader(0)
+                it = iter(loader)
+                for _ in range(stop_after):
+                    next(it)
+                state = loader.sampler.state_dict()
+                self.assertGreater(state["yielded"], stop_after * 4)
+                state["yielded"] = min(state["yielded"], stop_after * 4)
+                rest = [b.tolist() for b in it]
+                del it
+
+                resumed = make_loader(1)
+                resumed.sampler.load_state_dict(state)
+                self.assertEqual([b.tolist() for b in resumed], rest)
+
+    def test_load_rejects_incompatible_state(self):
+        sampler = self._sampler(10, False, None, None)
+        next(iter(sampler))
+        state = sampler.state_dict()
+        for other in (
+            self._sampler(11, False, None, None),
+            self._sampler(10, True, None, None),
+            self._sampler(10, False, 20, None),
+        ):
+            with self.assertRaisesRegex(ValueError, "was saved for num_data=10"):
+                other.load_state_dict(state)
+        for yielded in (-1, 11, 2.0, True):
+            with self.assertRaisesRegex(ValueError, "yielded="):
+                self._sampler(10, False, None, None).load_state_dict(
+                    {**state, "yielded": yielded}
+                )
+        with self.assertRaisesRegex(ValueError, "missing keys"):
+            self._sampler(10, False, None, None).load_state_dict({"yielded": 1})
+
+    def test_load_rejects_bad_generator_state_without_side_effects(self):
+        generator = self._generator(0)
+        sampler = self._sampler(10, False, None, generator)
+        next(iter(sampler))
+        state = sampler.state_dict()
+        before = generator.get_state()
+        with self.assertRaises(RuntimeError):
+            sampler.load_state_dict(
+                {**state, "epoch_generator_state": torch.zeros(3, dtype=torch.uint8)}
+            )
+        self.assertEqual(generator.get_state(), before)
+
+    def test_data_resized_after_load(self):
+        data = list(range(10))
+        from torch.utils.data import RandomSampler
+
+        sampler = RandomSampler(data)
+        next(iter(sampler))
+        resumed = RandomSampler(data)
+        resumed.load_state_dict(sampler.state_dict())
+        data.append(10)
+        with self.assertRaisesRegex(ValueError, "was saved for num_data=10"):
+            list(resumed)
+
