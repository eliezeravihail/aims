+class _RandomSamplerEpoch:
+    r"""Where one :class:`RandomSampler` iteration is, for :meth:`RandomSampler.state_dict`.
+
+    An iteration draws its order in blocks (a permutation of the data, or 32 draws
+    with replacement) and yields each block from a list iterator. The number of
+    samples yielded is read off that iterator's remaining length, so tracking it
+    costs nothing per sample.
+    """
+
+    __slots__ = (
+        "num_data",
+        "num_samples",
+        "seed",
+        "generator_state",
+        "_base",
+        "_block_len",
+        "_block_iter",
+    )
+
+    def __init__(
+        self,
+        num_data: int,
+        num_samples: int,
+        seed: int | None,
+        generator_state: torch.Tensor | None,
+    ) -> None:
+        self.num_data = num_data
+        self.num_samples = num_samples
+        # How the order was drawn: the seed of a private generator, or the state
+        # the sampler's own generator had when the iteration began.
+        self.seed = seed
+        self.generator_state = generator_state
+        self._base = 0
+        self._block_len = 0
+        self._block_iter: Iterator[int] = iter(())
+
+    def start_block(self, base: int, values: list[int]) -> Iterator[int]:
+        # ``base`` is the number of samples of the iteration that precede ``values``.
+        self._base = base
+        self._block_len = len(values)
+        self._block_iter = iter(values)
+        return self._block_iter
+
+    @property
+    def yielded(self) -> int:
+        return (
+            self._base + self._block_len - operator.length_hint(self._block_iter)
+        )
+
