{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Capsa release",
  "type": "object",
  "required": [
    "id",
    "version",
    "date",
    "commit"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 0
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}"
    },
    "commit": {
      "type": "string",
      "minLength": 7
    },
    "plan_refs": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "issue_refs": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "requirement_refs": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "notices_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "sbom_ref": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
