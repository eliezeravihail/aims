{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Capsa plan",
  "type": "object",
  "required": [
    "id",
    "title",
    "kind",
    "status",
    "opened"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 0
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "charter",
        "initiative",
        "maintenance"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "in_progress",
        "completed",
        "abandoned"
      ]
    },
    "opened": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}"
    },
    "completed": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}"
    },
    "priority": {
      "enum": [
        "P1",
        "P2",
        "P3",
        null
      ]
    },
    "target_date": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}"
    },
    "milestone": {
      "type": [
        "string",
        "null"
      ]
    },
    "requirement_refs": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "decision_refs": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    }
  }
}
