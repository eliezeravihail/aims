{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Capsa insight",
  "type": "object",
  "required": [
    "kind",
    "title",
    "created"
  ],
  "properties": {
    "kind": {
      "enum": [
        "dev",
        "design",
        "code"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "created": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}"
    },
    "updated": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}"
    },
    "code_globs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "code"
          }
        }
      },
      "then": {
        "required": [
          "code_globs"
        ],
        "properties": {
          "code_globs": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
