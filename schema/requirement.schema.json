{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Capsa requirement",
  "type": "object",
  "required": [
    "id",
    "title",
    "level",
    "status",
    "opened",
    "verification"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 0
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "level": {
      "enum": [
        "must",
        "should",
        "may"
      ]
    },
    "status": {
      "enum": [
        "proposed",
        "accepted",
        "met",
        "unmet",
        "dropped"
      ]
    },
    "opened": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}"
    },
    "verification": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "verified",
            "unverified",
            "failed"
          ]
        },
        "method": {
          "enum": [
            "test",
            "scan",
            "ci",
            "manual",
            "none"
          ]
        },
        "evidence_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "checked_at": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}"
        }
      },
      "required": [
        "status"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "verified"
              }
            }
          },
          "then": {
            "required": [
              "evidence_ref"
            ],
            "properties": {
              "evidence_ref": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "plan_refs": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "decision_refs": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "met"
          }
        }
      },
      "then": {
        "properties": {
          "verification": {
            "properties": {
              "status": {
                "const": "verified"
              }
            }
          }
        }
      }
    }
  ]
}
