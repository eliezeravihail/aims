{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Capsa decision (ADR)",
  "type": "object",
  "required": [
    "id",
    "title",
    "status",
    "date"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 0
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "proposed",
        "accepted",
        "superseded",
        "deprecated"
      ]
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}"
    },
    "supersedes": {
      "type": [
        "integer",
        "null"
      ]
    },
    "superseded_by": {
      "type": [
        "integer",
        "null"
      ]
    },
    "discussion_ref": {
      "type": [
        "integer",
        "null"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
